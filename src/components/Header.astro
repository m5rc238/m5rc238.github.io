---
const links = [{href:'/work/',label:'Work'},{href:'/writing/',label:'Writing'},{href:'/about/',label:'About'},{href:'/contact/',label:'Contact'}];
const current = Astro.url.pathname;
---
<header class="site-header wrap">
 <a class="wordmark" href="/" aria-label="Marcel Akiyama home"><span class="monogram" aria-hidden="true">✳</span> Marcel Akiyama<span class="wordmark-dot">.</span></a>
 <nav aria-label="Main navigation">{links.map(l=><a href={l.href} aria-current={current.startsWith(l.href)?'page':undefined}>{l.label}</a>)}</nav>
</header>
