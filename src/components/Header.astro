---
import site from '../data/site.json';

const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '';
const isCases = pathname.startsWith('/cases');
---

<header
	class="sticky top-0 z-40 border-b border-teal-dark/20 bg-white/72 backdrop-blur-[5px]"
>
	<div class="container-page flex h-16 items-center justify-between gap-6">
		<a
			href="/"
			aria-label="Marcel Akiyama — Home"
			class="flex items-center text-ink transition-opacity hover:opacity-75"
		>
			<svg width="28" height="16" viewBox="0 0 28 16" fill="none" aria-hidden="true">
				<path
					d="M 16 16 L 0 16 L 0 0 L 16 0 Z M 8 12 C 10.209 12 12 10.209 12 8 C 12 5.791 10.209 4 8 4 C 5.791 4 4 5.791 4 8 C 4 10.209 5.791 12 8 12 Z"
					fill="currentColor"
				/>
				<path
					d="M 28 8 C 28 10.209 26.209 12 24 12 C 21.791 12 20 10.209 20 8 C 20 5.791 21.791 4 24 4 C 26.209 4 28 5.791 28 8 Z"
					fill="currentColor"
				/>
			</svg>
		</a>

		<nav aria-label="Primary" class="flex items-center gap-5 sm:gap-7 text-sm font-medium">
			<a
				href="/"
				class:list={[
					'transition-colors hover:text-teal-dark',
					isHome ? 'text-ink' : 'text-muted',
				]}
			>
				Home
			</a>
			<a
				href="/cases/"
				class:list={[
					'transition-colors hover:text-teal-dark',
					isCases ? 'text-ink' : 'text-muted',
				]}
			>
				Case Studies
			</a>
			<a
				href={site.journalUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="text-muted transition-colors hover:text-teal-dark"
			>
				Journal
			</a>
			<a
				href={`mailto:${site.email}`}
				class="rounded-full border border-teal-dark/30 px-4 py-1.5 text-teal-dark transition-colors hover:border-teal-dark hover:bg-teal-dark hover:text-white"
			>
				Contact
			</a>
		</nav>
	</div>
</header>
