---
const links = [
	{ href: '/', label: 'Index' },
	{ href: '/work/', label: 'Work' },
	{ href: '/blog/', label: 'Writing' },
	{ href: '/manifesto/', label: 'Manifesto' },
];

const { pathname } = Astro.url;

const isActive = (href: string) =>
	href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header
	class="sticky top-0 z-50 border-b border-line/60 bg-surface/70 backdrop-blur-xl"
>
	<div class="container-page flex h-16 items-center justify-between gap-6">
		<a
			href="/"
			class="link-wipe font-display text-sm font-semibold tracking-tight"
		>
			m5rc238
		</a>

		<nav aria-label="Primary">
			<ul class="flex items-center gap-1 sm:gap-2">
				{
					links.map((link) => (
						<li>
							<a
								href={link.href}
								aria-current={isActive(link.href) ? 'page' : undefined}
								class:list={[
									'rounded-full px-3 py-1.5 text-sm transition-colors duration-300',
									isActive(link.href)
										? 'bg-raised text-body'
										: 'text-muted hover:text-body',
								]}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>
