---
import site from '../data/site.json';

const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '';
const isCases = pathname.startsWith('/cases');
---

<header
	class="sticky top-0 z-40 border-b border-teal-dark/20 bg-white/72 backdrop-blur-xs"
>
	<div class="container-page flex h-16 items-center justify-between gap-6">
		<a
			href="/"
			aria-label="Marcel Akiyama — Home"
			class="group flex items-center gap-2.5 text-sm font-medium text-teal-dark transition-opacity hover:opacity-80"
		>
			<!-- Minimalist two-dot mark matching the Framer header logo -->
			<svg
				width="32"
				height="24"
				viewBox="0 0 32 24"
				fill="none"
				xmlns="http://www.w3.org/2000/svg"
				aria-hidden="true"
			>
				<rect width="24" height="24" rx="6" fill="#034a43" />
				<circle cx="9.5" cy="12" r="3.5" fill="#ffffff" />
				<circle cx="28.5" cy="12" r="3.5" fill="#034a43" />
			</svg>
		</a>

		<nav aria-label="Primary" class="flex items-center gap-5 sm:gap-7 text-sm font-medium">
			<a
				href="/"
				class:list={[
					'transition-colors hover:text-teal-dark',
					isHome ? 'text-teal-dark' : 'text-muted',
				]}
			>
				Home
			</a>
			<a
				href="/cases/"
				class:list={[
					'transition-colors hover:text-teal-dark',
					isCases ? 'text-teal-dark' : 'text-muted',
				]}
			>
				Case Studies
			</a>
			<a
				href={site.journalUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="text-muted transition-colors hover:text-teal-dark"
			>
				Journal
			</a>
			<a
				href={`mailto:${site.email}`}
				class="rounded-full border border-teal-dark/30 px-4 py-1.5 text-teal-dark transition-colors hover:border-teal-dark hover:bg-teal-dark hover:text-white"
			>
				Contact
			</a>
		</nav>
	</div>
</header>
