---
import site from '../data/site.json';

interface Props {
	surface?: 'mint' | 'canvas';
}

const { surface = 'mint' } = Astro.props;
const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '';
const isCases = pathname.startsWith('/cases');
---

<header
	data-site-header
	data-surface={surface}
	class:list={[
		'sticky top-0 z-40 w-full backdrop-blur-md transition-colors duration-250',
		surface === 'canvas' ? 'bg-canvas/95' : 'bg-mint/95',
	]}
>
	<div class="container-page">
		<nav
			aria-label="Main navigation"
			class="flex items-center justify-between gap-6 border-b border-ink/20 py-5"
		>
			<a
				href="/"
				aria-label="Marcel Akiyama — Home"
				class="flex shrink-0 items-center text-ink transition-opacity hover:opacity-75"
			>
				<svg width="28" height="16" viewBox="0 0 28 16" fill="none" aria-hidden="true">
					<path
						d="M 16 16 L 0 16 L 0 0 L 16 0 Z M 8 12 C 10.209 12 12 10.209 12 8 C 12 5.791 10.209 4 8 4 C 5.791 4 4 5.791 4 8 C 4 10.209 5.791 12 8 12 Z"
						fill="currentColor"
					/>
					<path
						d="M 28 8 C 28 10.209 26.209 12 24 12 C 21.791 12 20 10.209 20 8 C 20 5.791 21.791 4 24 4 C 26.209 4 28 5.791 28 8 Z"
						fill="currentColor"
					/>
				</svg>
			</a>

			<div class="flex items-center gap-6 sm:gap-10 text-base sm:text-lg font-normal">
				<a
					href="/"
					class:list={[
						'hidden sm:inline transition-opacity hover:opacity-70',
						isHome ? 'text-ink' : 'text-ink/85',
					]}
				>
					Home
				</a>
				<a
					href="/cases/"
					class:list={[
						'transition-opacity hover:opacity-70',
						isCases ? 'text-ink' : 'text-ink/85',
					]}
				>
					Case Studies
				</a>
				<a
					href={site.journalUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="hidden sm:inline text-ink/85 transition-opacity hover:opacity-70"
				>
					Journal
				</a>
				<a
					data-header-cta
					href={`mailto:${site.email}`}
					class="rounded-[6px] border border-ink/25 bg-white px-7 py-2 text-base leading-[1.3] text-ink shadow-[0_1px_2px_rgba(3,74,67,0.06)] transition-[transform,border-color] hover:-translate-y-0.5 hover:border-ink/45 sm:px-12 sm:text-lg"
				>
					Contact
				</a>
			</div>
		</nav>
	</div>
</header>
