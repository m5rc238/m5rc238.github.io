---
import SysScene from './SysScene.astro';
---

<SysScene
	scene="revision"
	label="07 · Revision"
	note="revision is not erasure"
	quote="New evidence should be able to change conclusions."
>
	<div class="sys-flow" data-sys-revision>
		<div class="sys-flow__row">
			<div class="sys-node sys-node--decision" data-sys-revision-v1>
				<span class="sys-node__label">Decision v1</span>
				<span class="sys-node__caption">Adopt the assistant at once</span>
			</div>
		</div>

		<div class="sys-flow__link sys-flow__link--label" data-sys-revision-evidence>
			New evidence
		</div>

		<div class="sys-flow__row">
			<div class="sys-node sys-node--evidence" data-sys-revision-evidence-node>
				<span class="sys-node__label">Evidence</span>
				<span class="sys-node__caption">Peak-season failure rate: 41%</span>
			</div>
		</div>

		<div class="sys-flow__link" data-sys-revision-arrow aria-hidden="true"></div>

		<div class="sys-flow__row">
			<div class="sys-node sys-node--decision" data-sys-revision-v2>
				<span class="sys-node__label">Decision v2</span>
				<span class="sys-node__caption">Supervised triage, then re-evaluate</span>
			</div>
		</div>

		<div class="sys-flow__link sys-flow__link--label" data-sys-revision-history>
			v1 is kept as history
		</div>
	</div>
</SysScene>