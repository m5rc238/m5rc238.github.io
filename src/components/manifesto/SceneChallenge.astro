---
import SysScene from './SysScene.astro';

/** An auditable recommendation. State lives in the DOM — pressing the
 *  challenge button revises the shown epistemic state rather than spawning
 *  a decoration: confidence drops, a new conclusion is reached, and the
 *  previous conclusion stays visible as a ghost (revision ≠ erasure). */
---

<SysScene
	scene="challenge"
	label="05 · Decision"
	quote="Human agency requires meaningful challenge, not just human presence."
>
	<div class="sys-challenge" data-sys-challenge>
		<div class="sys-rec" data-sys-rec>
			<div class="sys-rec__head">
				<span class="sys-rec__tag">Recommendation</span>
				<span class="sys-rec__tag" data-status>Confident</span>
			</div>

			<p class="sys-rec__conclusion" data-conclusion>
				Deploy the assistant on the support desk automatically.
			</p>

			{/* The challenged conclusion is never deleted — it is struck through
			    and stays in view as the path the revision took. */}
			<p class="sys-rec__conclusion sys-ghost sys-challenge-hidden" data-ghost-conclusion>
				This recommendation was revised after review.
			</p>

			<div class="sys-rec__ev">
				<div class="sys-rec__ev-row">
					<strong>Evidence</strong><span>6 transcripts, 2 policies</span>
				</div>
				<div class="sys-rec__ev-row">
					<strong>Assumption</strong><span>Demand is steady year-round</span>
				</div>
				<div class="sys-rec__ev-row">
					<strong>Uncertainty</strong><span>Peak season untested</span>
				</div>
			</div>

			<div class="sys-confidence">
				<div class="sys-confidence__label">
					<span>Confidence</span>
					<strong data-confidence-value>84%</strong>
				</div>
				<div class="sys-confidence__bar">
					<div class="sys-confidence__fill" data-confidence-meter style="width: 84%"></div>
				</div>
			</div>

			<div class="sys-rec__actions">
				<button class="sys-btn sys-btn--primary" type="button" data-challenge>
					Challenge this
				</button>
			</div>
		</div>

		<div class="sys-review sys-challenge-hidden" data-review hidden>
			<p class="sys-review__note">
				<strong>The assumption failed.</strong> Peak-season volumes the
				training transcripts never touched break the steady-demand model.
			</p>
			<p class="sys-review__note">
				<strong>Revised.</strong> Deploy to supervised triage first, keep
				the human in the authorization loop, and re-evaluate after one
				season of live data.
			</p>
		</div>
	</div>
</SysScene>