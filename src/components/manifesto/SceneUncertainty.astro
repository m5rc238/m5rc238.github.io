---
import SysScene from './SysScene.astro';
---

<SysScene
	scene="uncertainty"
	label="03 · Interpretation"
	note="A valid epistemic state"
	quote="“We don’t know” is a valid result."
>
	<div class="sys-flow" data-sys-uncertainty>
		<div class="sys-flow__row">
			<div class="sys-node sys-node--input">
				<span class="sys-node__label">Question</span>
			</div>
		</div>

		<div class="sys-flow__link" data-sys-uncertainty-arrow aria-hidden="true"></div>

		<div class="sys-flow__row">
			<div class="sys-node sys-node--reasoning" data-sys-uncertainty-evidence>
				<span class="sys-node__label">Insufficient evidence</span>
				<span class="sys-node__caption">What we have cannot decide it</span>
			</div>
		</div>

		<div class="sys-flow__link" data-sys-uncertainty-arrow-2 aria-hidden="true"></div>

		<div class="sys-flow__row">
			<div class="sys-node sys-node--unknowing" data-sys-uncertainty-outcome>
				<span class="sys-node__label">We don’t know</span>
				<span class="sys-node__caption">held in place, on purpose</span>
			</div>
		</div>
	</div>
</SysScene>