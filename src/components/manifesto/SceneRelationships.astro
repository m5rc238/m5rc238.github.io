---
import SysScene from './SysScene.astro';

const chain = [
	{ kind: 'claim', label: 'Claim' },
	{ kind: 'evidence', label: 'Evidence' },
	{ kind: 'assumption', label: 'Assumption' },
	{ kind: 'reasoning', label: 'Interpretation' },
	{ kind: 'decision', label: 'Decision' },
	{ kind: 'outcome', label: 'Outcome' },
];
---

<SysScene
	scene="relationships"
	label="06 · Connection"
	note="fact ≠ inference"
	quote="A fact should be distinguishable from an inference."
>
	<div class="sys-flow" data-sys-relationships>
		{
			chain.map((n, i) => (
				<>
					<div class="sys-flow__row">
						<div
							class:list={['sys-node', `sys-node--${n.kind}`]}
							data-sys-relationship={i}
						>
							<span class="sys-node__label">{n.label}</span>
						</div>
					</div>
					{i < chain.length - 1 && (
						<div class="sys-flow__link" data-sys-relationship-link={i} aria-hidden="true"></div>
					)}
				</>
			))
		}
	</div>
</SysScene>