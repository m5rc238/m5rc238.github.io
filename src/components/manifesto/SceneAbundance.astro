---
import SysScene from './SysScene.astro';

const words = [
	'Answer', 'Citation', 'Summary', 'Prediction', 'Report',
	'Claim', 'Data', 'Model', 'Thread', 'Document',
	'Analysis', 'Recommendation', 'Draft', 'Score', 'Alert',
	'Ranking', 'Synthesis', 'Draft 3', 'Forecast', 'Reply',
	'Digest', 'Draft 7', 'Pipeline', 'Corpus', 'Embedding',
	'Rank 2', 'Annotation', 'Draft 12', 'Confidence', 'Update',
];
---

<SysScene
	scene="abundance"
	label="01 · Information"
	quote="We can produce more information than anyone can realistically examine."
>
	<div class="sys-abundance">
		<div class="sys-words" data-sys-abundance-words role="presentation">
			{
				words.map((w) => (
					<span class="sys-words__w">{w}</span>
				))
			}
		</div>

		<p class="sys-abundance__ask" data-sys-abundance-ask>
			What deserves to be believed?
		</p>
	</div>
</SysScene>