---
import SysScene from './SysScene.astro';

/** The final scene. Six phases of the system become a single closed loop —
 *  the outcome is new evidence. Rendered as nodes on a ring with a persistent
 *  arrow; the whole ring drifts slowly (CSS, killed under reduce-motion),
 *  but nothing here loops as a cheesy spinner — it simply *is* a loop. */
const ring = [
	{ kind: 'evidence', label: 'Evidence', top: '0%', left: '50%' },
	{ kind: 'interpretation', label: 'Interpretation', top: '25%', left: '97%' },
	{ kind: 'decision', label: 'Decision', top: '75%', left: '97%' },
	{ kind: 'action', label: 'Action', top: '100%', left: '50%' },
	{ kind: 'outcome', label: 'Outcome', top: '75%', left: '3%' },
	{ kind: 'new evidence', label: 'New evidence', top: '25%', left: '3%' },
];
---

<SysScene
	scene="loop"
	label="10 · Resilience"
	quote="The outcome becomes new evidence."
>
	<div class="sys-loop" data-sys-loop>
		<svg
			class="sys-loop__ring"
			viewBox="0 0 300 300"
			fill="none"
			aria-hidden="true"
		>
			<circle cx="150" cy="150" r="118" stroke="var(--color-line)" stroke-dasharray="2 5" />
			<path
				d="M 150 150 L 268 150"
				stroke="var(--color-accent-strong)"
				stroke-width="1"
			/>
			{/* direction arrow */}
			<path d="M 268 150 L 256 143 M 268 150 L 256 157" stroke="var(--color-accent-strong)" stroke-width="1.5" />
		</svg>

		<div class="sys-loop__rotate" data-sys-loop-rotate>
			{
				ring.map((n) => (
					<div
						class:list={['sys-node', 'sys-loop__node', `sys-node--${n.kind}`]}
						style={`top: ${n.top}; left: ${n.left}`}
					>
						<span class="sys-node__label">{n.label}</span>
					</div>
				))
			}
		</div>

		<div class="sys-loop__center">
			<span class="sys-node__label">A system that stays connected</span>
			<p>wrong can surface, decisions can be reconstructed, and the loop can turn again.</p>
		</div>
	</div>
</SysScene>