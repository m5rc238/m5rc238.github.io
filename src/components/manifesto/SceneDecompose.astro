---
import SysScene from './SysScene.astro';

const parts = [
	{ kind: 'evidence', label: 'Evidence' },
	{ kind: 'assumption', label: 'Assumptions' },
	{ kind: 'reasoning', label: 'Reasoning' },
	{ kind: 'uncertainty', label: 'Uncertainty' },
];
---

<SysScene
	scene="decompose"
	label="02 · Claim"
	quote="A convincing answer is not necessarily a true answer."
>
	<div class="sys-flow" data-sys-decompose>
		<div class="sys-flow__row">
			<div class="sys-node sys-node--answer" data-sys-answer>
				<span class="sys-node__label">Answer</span>
			</div>
		</div>

		<div class="sys-flow__link" data-sys-decompose-link aria-hidden="true"></div>

		<div class="sys-flow__row" data-sys-decompose-parts>
			{
				parts.map((p) => (
					<div class:list={['sys-node', `sys-node--${p.kind}`]} data-sys-part>
						<span class="sys-node__label">{p.label}</span>
					</div>
				))
			}
		</div>
	</div>
</SysScene>