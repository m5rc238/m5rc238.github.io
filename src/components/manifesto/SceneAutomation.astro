---
import SysScene from './SysScene.astro';
---

<SysScene
	scene="automation"
	label="09 · Boundary"
	note="automation is not absolution"
	quote="Automating work is not the same thing as automating responsibility."
>
	<div class="sys-auto-stage" data-sys-automation>
		{/* Phase 1 — human judgment drives action. */}
		<div class="sys-auto-stage__row" data-auto-phase="1">
			<div class="sys-node sys-node--human">
				<span class="sys-node__label">Human</span>
			</div>
			<div class="sys-flow__link" aria-hidden="true"></div>
			<div class="sys-node sys-node--judgment" data-auto-judgment>
				<span class="sys-node__label">Judgment</span>
			</div>
			<div class="sys-flow__link" aria-hidden="true"></div>
			<div class="sys-node sys-node--action">
				<span class="sys-node__label">Action</span>
			</div>
		</div>

		{/* Phase 2 — automation moves in alongside judgment. */}
		<div class="sys-auto-stage__row" data-auto-phase="2">
			<div class="sys-flow__link" aria-hidden="true"></div>
			<div class="sys-node sys-node--automation">
				<span class="sys-node__label">Automation → Action</span>
			</div>
			<div class="sys-flow__link" aria-hidden="true"></div>
		</div>
	</div>
</SysScene>