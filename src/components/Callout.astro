---
interface Props {
	tone?: 'accent' | 'neutral';
}

const { tone = 'neutral' } = Astro.props;

const accent = tone === 'accent';
---

<aside
	class:list={[
		'clip-radius my-8 border-l-2 p-5',
		accent
			? 'border-accent-500 bg-accent-500/8 text-body'
			: 'border-line bg-raised/60 text-muted',
	]}
>
	<slot />
</aside>
