---
import site from '../data/site.json';
---

<section class="bg-forest-deep py-20 text-teal-accent md:py-24">
	<div class="container-page flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
		<div class="max-w-xl">
			<p class="section-eyebrow text-teal-accent/80">{site.cta.heading}</p>
			<h2 class="mt-3 text-2xl font-light leading-snug text-mint-soft md:text-3xl">
				{site.cta.text}
			</h2>
		</div>

		<a
			href={`mailto:${site.email}`}
			class="inline-flex shrink-0 items-center gap-2 rounded-full bg-teal-accent px-7 py-3 text-sm font-medium text-obsidian transition-transform hover:-translate-y-0.5 hover:bg-mint-soft"
		>
			{site.cta.buttonLabel}
			<span aria-hidden="true">&rarr;</span>
		</a>
	</div>
</section>

<footer class="bg-obsidian py-10 text-white/70">
	<div class="container-page flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
		<p class="text-sm text-white/60">
			{site.footer.credit}
		</p>

		<ul class="flex flex-wrap items-center gap-2.5">
			{
				site.socialLinks.map((item) => (
					<li>
						<a
							href={item.href}
							target="_blank"
							rel="me noopener noreferrer"
							aria-label={item.label}
							title={item.label}
							class="flex h-10 w-10 items-center justify-center rounded-full bg-teal-accent/10 text-white transition-colors hover:bg-teal-accent/25 hover:text-teal-accent"
						>
							{item.icon === 'github' && (
								<svg width="16" height="16" viewBox="0 0 18 18" fill="currentColor" aria-hidden="true">
									<path d="M 9 0 C 4.03 0 0 4.131 0 9.227 C 0 13.305 2.578 16.764 6.155 17.983 C 6.605 18.069 6.77 17.783 6.77 17.54 C 6.77 17.32 6.761 16.593 6.758 15.821 C 4.254 16.38 3.725 14.733 3.725 14.733 C 3.316 13.666 2.726 13.383 2.726 13.383 C 1.909 12.81 2.788 12.822 2.788 12.822 C 3.691 12.887 4.167 13.773 4.167 13.773 C 4.97 15.183 6.273 14.776 6.786 14.54 C 6.867 13.943 7.1 13.536 7.358 13.306 C 5.359 13.073 3.257 12.281 3.257 8.746 C 3.257 7.738 3.609 6.915 4.185 6.269 C 4.091 6.037 3.783 5.098 4.272 3.827 C 4.272 3.827 5.028 3.579 6.747 4.772 C 7.482 4.568 8.239 4.464 9 4.463 C 9.765 4.466 10.535 4.569 11.255 4.773 C 12.973 3.579 13.727 3.828 13.727 3.828 C 14.217 5.098 13.909 6.037 13.815 6.269 C 14.392 6.915 14.742 7.739 14.742 8.746 C 14.742 12.29 12.636 13.071 10.632 13.299 C 10.955 13.585 11.243 14.147 11.243 15.008 C 11.243 16.242 11.232 17.236 11.232 17.54 C 11.232 17.786 11.394 18.073 11.85 17.983 C 15.425 16.761 18 13.303 18 9.227 C 18 4.131 13.971 0 9 0 Z" />
								</svg>
							)}
							{item.icon === 'bluesky' && (
								<svg width="16" height="14" viewBox="0 0 16 14" fill="currentColor" aria-hidden="true">
									<path d="M 3.468 0.942 C 5.303 2.311 7.276 5.086 8 6.575 C 8.724 5.086 10.698 2.311 12.532 0.942 C 13.855 -0.045 16 -0.809 16 1.622 C 16 2.108 15.72 5.701 15.556 6.285 C 14.985 8.313 12.903 8.83 11.052 8.517 C 14.288 9.065 15.111 10.877 13.333 12.69 C 9.957 16.133 8.481 11.826 8.102 10.723 C 7.993 10.405 8.009 10.398 7.897 10.723 C 7.519 11.826 6.043 16.133 2.667 12.69 C 0.889 10.877 1.712 9.065 4.948 8.517 C 3.097 8.83 1.015 8.313 0.444 6.285 C 0.28 5.701 0 2.108 0 1.622 C 0 -0.809 2.145 -0.045 3.468 0.942 Z" />
								</svg>
							)}
							{item.icon === 'linkedin' && (
								<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									<path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77Z" />
								</svg>
							)}
							{item.icon === 'dribbble' && (
								<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<circle cx="12" cy="12" r="10" />
									<path d="M19.13 5.09C15.22 9.14 10 10.44 2.25 10.94" />
									<path d="M21.75 12.84c-6.62-1.41-12.14 1-16.38 6.32" />
									<path d="M8.56 2.75c4.37 6 6 9.42 8 17.72" />
								</svg>
							)}
							{item.icon === 'behance' && (
								<svg width="16" height="12" viewBox="0 0 24 16" fill="currentColor" aria-hidden="true">
									<path d="M22 4.5h-5.5V3H22v1.5zm-2.75 2c-2.5 0-4.25 1.85-4.25 4.45 0 2.7 1.65 4.55 4.25 4.55 2.15 0 3.65-1.15 4.1-2.8h-2.1c-.25.7-.95 1.15-1.95 1.15-1.25 0-2.1-.8-2.2-2.15h6.35c.1-3.15-1.45-5.2-4.2-5.2zm-2.1 3.65c.2-1.15 1-1.95 2.1-1.95 1.15 0 1.9.75 2.05 1.95h-4.15zM9.7 7.65c.95-.45 1.55-1.35 1.55-2.55 0-2.15-1.6-3.1-4.1-3.1H1v13h6.35c2.65 0 4.4-1.25 4.4-3.75 0-1.65-.8-2.9-2.05-3.6zM3.6 4.1h3.25c1.15 0 1.85.5 1.85 1.45 0 .95-.7 1.45-1.85 1.45H3.6V4.1zm3.45 8.8H3.6V9.2h3.45c1.3 0 2.05.55 2.05 1.85 0 1.3-.75 1.85-2.05 1.85z" />
								</svg>
							)}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</footer>
