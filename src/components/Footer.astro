---
const year = new Date().getFullYear();
---

<footer class="mt-32 border-t border-line/60">
	<div class="container-page py-12">
		<div
			class="flex flex-col gap-8 sm:flex-row sm:items-center sm:justify-between"
		>
			<div class="space-y-2">
				<p class="text-sm text-muted">
					Built with Astro, Tailwind, and GSAP.
				</p>
				<p class="font-mono text-xs text-ink-500">
					&copy; {year} m5rc238
				</p>
			</div>

			<ul class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
				{
					['Email', 'GitHub', 'Bluesky', 'RSS'].map((label) => (
						<li>
							<a href="#" class="link-wipe text-muted hover:text-body">
								{label}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</footer>
