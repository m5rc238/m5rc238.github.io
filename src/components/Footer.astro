---
import site from '../data/site.json';

interface Props {
	surface?: 'mint' | 'canvas';
}

const { surface = 'mint' } = Astro.props;
const linkedinLink = site.socialLinks.find((l) => l.icon === 'linkedin');
const footerSurfaceClass = surface === 'canvas' ? 'bg-mint' : 'bg-transparent';
---

<section
	class:list={[
		'relative z-10 pt-16 pb-4 text-ink md:pt-24 md:pb-6',
		footerSurfaceClass,
	]}
>
	<div class="container-page flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
		<div class="max-w-2xl">
			<p class="section-eyebrow text-teal-mid" data-reveal="words" data-i18n="cta.heading">{site.cta.heading}</p>
			<h2
				class="mt-4 text-2xl font-light leading-[1.35] text-ink md:text-4xl"
				data-reveal="words"
				data-i18n="cta.text"
			>
				{site.cta.text}
			</h2>
		</div>

		<div class="flex flex-wrap items-center gap-3" data-reveal="fade">
			<a
				href={`mailto:${site.email}`}
				data-i18n="cta.button"
				class="inline-flex shrink-0 items-center justify-center rounded-[6px] bg-ink px-8 py-2.5 text-base font-medium text-white transition-transform hover:-translate-y-0.5 hover:bg-teal-mid sm:px-10 sm:text-lg"
			>
				{site.cta.buttonLabel}
			</a>
			<button
				type="button"
				data-copy-email={site.email}
				class="inline-flex shrink-0 cursor-pointer items-center justify-center rounded-[6px] border border-ink/30 px-5 py-2.5 text-base font-normal text-ink transition-colors hover:border-ink hover:bg-ink/5 sm:text-lg"
			>
				<span data-copy-label data-i18n="cta.copy">Copy email</span>
			</button>
			{
				linkedinLink && (
					<a
						href={linkedinLink.href}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex shrink-0 items-center justify-center rounded-[6px] border border-ink/25 px-5 py-2.5 text-base font-normal text-ink/85 transition-colors hover:border-ink hover:text-ink sm:text-lg"
					>
						LinkedIn &nearr;
					</a>
				)
			}
			<span class="sr-only" aria-live="polite" data-copy-status></span>
		</div>
	</div>
</section>

<script>
	import { translations, type Lang } from '../i18n/translations';

	const copyButtons = document.querySelectorAll<HTMLButtonElement>('[data-copy-email]');
	for (const btn of copyButtons) {
		btn.addEventListener('click', async () => {
			const email = btn.dataset.copyEmail;
			if (!email) return;
			const label = btn.querySelector<HTMLElement>('[data-copy-label]');
			const status = btn.parentElement?.querySelector<HTMLElement>('[data-copy-status]');
			const lang = (document.documentElement.lang as Lang) || 'en';
			const dict = translations[lang] || translations.en;

			try {
				await navigator.clipboard.writeText(email);
				if (label) label.textContent = dict['cta.copied'] || 'Copied!';
				if (status) status.textContent = `Copied ${email} to clipboard.`;
				window.setTimeout(() => {
					const activeLang = (document.documentElement.lang as Lang) || 'en';
					const activeDict = translations[activeLang] || translations.en;
					if (label) label.textContent = activeDict['cta.copy'] || 'Copy email';
					if (status) status.textContent = '';
				}, 2000);
			} catch {
				if (label) label.textContent = email;
			}
		});
	}
</script>

<footer
	class:list={[
		'relative z-10 flex min-h-[clamp(340px,52vw,920px)] w-full flex-col justify-end overflow-hidden',
		footerSurfaceClass,
	]}
>
	<img
		src="/images/footer-mint-landscape.jpg"
		alt=""
		aria-hidden="true"
		loading="lazy"
		decoding="async"
		class="pointer-events-none absolute inset-0 h-full w-full object-cover object-bottom"
		style="-webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 24%, black 100%); mask-image: linear-gradient(to bottom, transparent 0%, black 24%, black 100%);"
	/>
	<div
		class="pointer-events-none absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-[#021916]/50 via-[#021916]/20 to-transparent"
		aria-hidden="true"
	></div>
	<div
		data-reveal="up"
		class="container-page relative z-10 flex flex-col items-center justify-between gap-6 py-8 sm:flex-row md:py-10"
	>
		<div class="order-1 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-sm drop-shadow-[0_1px_3px_rgba(2,25,22,0.5)] sm:order-0 sm:justify-start">
			<p class="font-medium text-white/95" data-i18n="footer.credit">
				{site.footer.credit}
			</p>
			<span class="text-white/50" aria-hidden="true">&middot;</span>
			<a href="/privacy/" class="text-white/80 transition-colors hover:text-white">
				Privacy
			</a>
			<a href="/terms/" class="text-white/80 transition-colors hover:text-white">
				Terms
			</a>
		</div>

		<ul class="order-0 flex flex-wrap items-center gap-5 sm:order-1">
			{
				site.socialLinks.map((item) => (
					<li>
						<a
							href={item.href}
							target="_blank"
							rel="me noopener noreferrer"
							aria-label={item.label}
							title={item.label}
							class="flex h-[42px] w-[42px] items-center justify-center rounded-[21px] border border-white/25 bg-white/80 text-ink shadow-xs backdrop-blur-md transition-colors hover:border-ink hover:bg-ink hover:text-white"
