---
import '@fontsource-variable/inter';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import profile from '../data/profile.json';
interface Props { title?:string; description?:string; kind?:string; noindex?:boolean; }
const {title='Marcel Akiyama — Product Designer, Researcher & Builder',description=profile.description,kind='WebPage',noindex=false}=Astro.props;
const base='https://m5rc238.github.io';
const canonical = new URL(Astro.url.pathname,base).href;
const person = {'@type':'Person','@id':base+'/#person',name:profile.name,alternateName:profile.handle,url:base+'/',jobTitle:profile.role,description:profile.description,sameAs:profile.links.map(l=>l.url)};
const graph={'@context':'https://schema.org','@graph':[person,{'@type':'WebSite','@id':base+'/#website',url:base+'/',name:'Marcel Akiyama',publisher:{'@id':base+'/#person'},inLanguage:'en'}, {'@type':kind,'@id':canonical+'#webpage',url:canonical,name:title,description,isPartOf:{'@id':base+'/#website'},about:{'@id':base+'/#person'},...(kind==='ProfilePage'?{mainEntity:{'@id':base+'/#person'},dateModified:profile.updated}:{})}]};
---
<!doctype html>
<html lang="en">
<head>
 <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
 <title>{title}</title><meta name="description" content={description} />
 <meta name="author" content={profile.name} /><meta name="robots" content={noindex?'noindex,follow':'index,follow,max-image-preview:large'} />
 <link rel="canonical" href={canonical} /><link rel="icon" type="image/svg+xml" href="/favicon.svg" />
 <meta name="theme-color" content="#f5f2e9" /><meta name="color-scheme" content="light" />
 <meta property="og:type" content="website" /><meta property="og:site_name" content="Marcel Akiyama" /><meta property="og:locale" content="en_US" />
 <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
 <meta property="og:image" content={base+'/social-card.png'} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
 <meta property="og:image:alt" content="Marcel Akiyama — Product designer, researcher and builder. A blue geometric drawing on warm paper." />
 <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={base+'/social-card.png'} />
 <link rel="alternate" type="text/markdown" href="/profile.md" title="Marcel Akiyama — plain-text profile" />
 <script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g,'\u003c')}></script>
</head>
<body><a class="skip" href="#main">Skip to content</a><Header /><main id="main" tabindex="-1"><slot /></main><Footer /></body>
</html>
