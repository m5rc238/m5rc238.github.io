---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
---

<Base
	title="m5rc238"
	description="Designer and developer working in the space between type, motion, and the web."
>
	<Header slot="header" />

	<section class="container-page flex flex-1 flex-col justify-center py-32">
		<p class="eyebrow mb-6">m5rc238</p>
		<h1 class="max-w-[20ch] text-balance text-title">
			Designer and developer.
		</h1>
		<p class="standfirst mt-6 max-w-[52ch] text-lede">
			This site is being rebuilt. The manifesto that used to live here now has
			its own home.
		</p>
		<p class="mt-10 max-w-[52ch] text-sm text-soft">
			<a
				class="link-wipe text-accent-strong"
				href="https://m5rc238.github.io/epistemic-resilience/"
			>
				Read the manifesto
			</a>
		</p>
	</section>
</Base>