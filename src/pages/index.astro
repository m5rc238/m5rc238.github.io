						</div>
					)}
				</div>

				<div class="flex flex-col justify-between gap-5 bg-forest-deep px-7 py-7 text-mint-soft sm:flex-row sm:items-center sm:px-10">
					<div>
						<p class="font-mono text-[11px] uppercase tracking-widest text-teal-accent" data-i18n="cta.heading">
