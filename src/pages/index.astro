---
import Base from '../layouts/Base.astro';
import Geometry from '../components/Geometry.astro';
import p from '../data/profile.json';
---
<Base>
 <section class="hero wrap">
  <div class="hero-intro"><p class="eyebrow">Independent practice / design & research</p><h1>Marcel Akiyama<span class="title-dot">.</span></h1><p class="hero-role">Product designer, researcher <em>& builder.</em></p></div>
  <div class="hero-grid"><div class="hero-copy"><h2>Good questions.<br/>Clearer decisions.</h2><p>{p.intro}</p><p class="muted">10+ years across fintech, developer tools, B2B SaaS, and AI. Previously a founding designer at Alpaca.</p><div class="text-links"><a class="arrow-link" href="/work/">Explore my work <span>↗</span></a><a class="quiet-link" href="/about/">A little about me →</a></div></div><Geometry /></div>
  <div class="hero-bottom"><span>Product design · UX research · Design systems · Human–AI interaction</span><a href="#selected-work">Keep exploring ↓</a></div>
 </section>
 <section id="selected-work" class="work-section section-space">
  <div class="wrap"><div class="section-heading"><div><p class="eyebrow">01 / Selected explorations</p><h2>Questions I’m<br/><em>building around.</em></h2></div><p>Small products and prototypes that make ideas concrete enough to examine.</p></div>
  <div class="project-grid">{p.projects.map((project,i)=><article class="project-card"><a class="project-art art-color" href={project.url} aria-label={`${project.name} — view repository`}>
   {i===0?<svg viewBox="0 0 360 220" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.1"><path d="M90 110L180 50L270 110L180 170ZM90 110L180 110L270 110M180 50V170"/>{[[90,110],[180,50],[270,110],[180,170],[180,110]].map(([x,y])=><circle cx={x} cy={y} r="17" fill="#e4ece9"/>)}</g><circle cx="180" cy="110" r="5" fill="#a7442d"/></svg>:i===1?<svg viewBox="0 0 360 220" aria-hidden="true"><g fill="#f1e3d9" stroke="currentColor" stroke-width="1.1">{[0,1,2,3,4].map(j=><rect x={95+j*17} y={48+j*13} width="112" height="85" rx="7"/>)}<path d="M163 116h88"/></g><circle cx="179" cy="105" r="3" fill="currentColor"/></svg>:<svg viewBox="0 0 360 220" aria-hidden="true"><text x="88" y="143" fill="currentColor" font-family="Georgia,serif" font-size="102" font-style="italic">Aa</text><path d="M84 156H268M240 70V143M230 70H250M230 143H250" stroke="currentColor" fill="none"/></svg>}
   <span class="art-arrow">↗</span></a><p class="project-meta">{project.category}</p><h3><a href={project.url}>{project.name}</a></h3><p>{project.summary}</p><span class="project-status">{project.status}</span></article>)}</div>
   <div class="section-tail"><span>Experiments, with their questions and limits left visible.</span><a class="arrow-link" href="/work/">All work & background ↗</a></div>
  </div>
 </section>
 <section class="writing-feature wrap section-space"><div class="section-heading"><div><p class="eyebrow">02 / Writing & learning</p><h2>Start with<br/><em>a better question.</em></h2></div><a class="arrow-link" href="/writing/">Explore writing ↗</a></div>
 <a class="course-feature" href="/writing/problem-framing/"><div class="course-illustration" aria-hidden="true"><svg viewBox="0 0 360 260"><g fill="none" stroke="currentColor" stroke-width="1.4"><rect x="93" y="47" width="175" height="175" transform="rotate(-10 180 130)"/><circle cx="180" cy="130" r="73"/><path d="M70 130H290M180 20V240M123 73L237 187M123 187L237 73"/><circle cx="180" cy="130" r="42"/></g><circle cx="180" cy="130" r="6" fill="#a7442d"/></svg></div><div class="course-copy"><p class="eyebrow">Field course / Product judgment</p><h3>How to frame<br/>a problem well.</h3><p>Examine evidence. Compare explanations. Decide what to investigate before jumping to a solution.</p><span class="arrow-link">Explore the course →</span></div></a></section>
 <section class="about-band"><div class="wrap about-band-inner"><p class="eyebrow">03 / A way of working</p><div><h2>Make the thinking<br/><em>easier to see.</em></h2><p>{p.focus}</p><a class="arrow-link" href="/about/">More about my approach ↗</a></div></div></section>
 <section class="contact-strip wrap"><p>Something worth figuring out?</p><a href="/contact/">Let’s talk <span>↗</span></a></section>
</Base>
