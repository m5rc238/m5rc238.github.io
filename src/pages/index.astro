		class="snap-nav fixed top-1/2 right-5 z-30 hidden -translate-y-1/2 flex-col items-end gap-1.5 rounded-[22px] border border-ink/12 bg-white/75 px-2.5 py-3 shadow-xs backdrop-blur-md xl:flex"
