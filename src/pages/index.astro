						<path d="M46.5,7C46,6.3,45.2,6,43.7,5.7c-0.6-0.1-1.3-0.2-1.7-0.5c-0.2-0.1-0.3-0.3-0.3-0.4c0-0.2,0.1-0.3,0.3-0.4 c0.4-0.2,1.1-0.3,2.1-0.1c1,0.2,2.1,0.6,2.4,0.7V2.6c-1.2-0.6-2.3-0.8-3.4-0.8c-1.1,0-2.1,0.3-2.8,0.8C39.6,3.2,39.1,4,39.1,5 C39,6.6,40,7.5,42.4,8c0.5,0.1,1.2,0.2,1.5,0.4c0.3,0.1,0.5,0.3,0.5,0.6c0,0.2-0.2,0.4-0.4,0.5c-0.4,0.2-1.1,0.2-1.6,0.1 c-1.3-0.1-2.6-0.6-3.1-0.8v2.4c0.8,0.4,2,0.9,3.5,0.8c1.7,0,3.8-0.5,4.2-2.8C47.1,8.4,46.9,7.6,46.5,7z" fill="currentColor" />
