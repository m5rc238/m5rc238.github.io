---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import site from '../data/site.json';

const allCases = await getCollection('cases');
const featuredCases = allCases
	.filter((c) => c.data.featured)
	.sort((a, b) => a.data.order - b.data.order);

const journalPosts = (await getCollection('journal')).sort(
	(a, b) => a.data.order - b.data.order,
);

const casesById = new Map(allCases.map((entry) => [entry.id, entry]));

const pillars = [
	{
		id: 'evaluation-thinking',
		i18nPrefix: 'pillars.eval',
		iconSrc: '/images/lenses/systems.jpg',
		number: '01',
		dotColor: '#f59e0b',
		title: 'Evaluation Thinking',
		tagline: 'Knowing what good looks like.',
		description:
			'A demo can look impressive in a controlled test and still fail in real use. I build evaluation criteria, run structured experiments, and use critical judgment to measure whether an AI feature is actually reliable and useful.',
		caseIds: ['ai-evals', 'epistemia-ux', 'decision-router', 'tablox'],
	},
	{
		id: 'systems-design',
		i18nPrefix: 'pillars.systems',
		iconSrc: '/images/lenses/framing.jpg',
		number: '02',
		dotColor: '#0ea5e9',
		title: 'Systems Design',
		tagline: 'Building infrastructure for intelligence.',
		description:
			'Great products rely on clear structure underneath. I design component libraries, shared knowledge, workflows, and practical guardrails so both people and AI agents can work consistently at scale.',
		caseIds: ['alpaca-ds', 'alpaca-logo', 'decision-router', 'easyudi'],
	},
	{
		id: 'problem-framing',
		i18nPrefix: 'pillars.framing',
		iconSrc: '/images/lenses/evaluation.jpg',
		number: '03',
		dotColor: '#f43f5e',
		title: 'Problem Framing',
		tagline: 'Knowing what is worth solving.',
		description:
			'Before jumping into solutions, I talk to users, question assumptions, and define what actually matters. Turning an unclear problem into a sharp direction is where the biggest leverage comes from.',
		caseIds: ['easyudi', 'spean', 'labellio', 'fansfirst'],
	},
].map((pillar) => ({
	...pillar,
	projects: pillar.caseIds
		.map((id) => casesById.get(id))
		.filter((entry): entry is NonNullable<typeof entry> => Boolean(entry)),
}));

interface KgNode {
	id: string;
	label: string;
	x: number;
	y: number;
	pillBg: string;
	accent: string;
	image?: string;
	icon?: 'layers' | 'grid';
	relation: string;
	summary: string;
	href?: string;
}

const kgNodes: KgNode[] = [
	{
		id: 'marcel',
		label: 'Marcel Akiyama',
		x: 295,
		y: 225,
		pillBg: '#ffe4e6',
		accent: '#e11d48',
		image: '/images/avatar.jpg',
		relation: 'Product Designer & Builder',
		summary: 'Connecting evidence, systems thinking, and hands-on code.',
	},
	{
		id: 'alpaca',
		label: 'Alpaca (YC W19)',
		x: 120,
		y: 80,
		pillBg: '#fef3c7',
		accent: '#d97706',
		image: '/images/cases/alpaca-logo-1.webp',
		relation: 'Founding Product Designer',
		summary: 'Shaped the brand identity, developer platform, and design system from early YC days.',
		href: '/cases/alpaca-ds/',
	},
	{
		id: 'fintech',
		label: 'Fintech & SaaS',
		x: 315,
		y: 68,
		pillBg: '#e0f2fe',
		accent: '#0284c7',
		icon: 'layers',
		relation: '10+ Years Experience',
		summary: 'Designing high-trust financial workflows, B2B tools, and complex product surfaces.',
		href: '/cases/easyudi/',
	},
	{
		id: 'labellio',
		label: 'Labellio',
		x: 515,
		y: 92,
		pillBg: '#ede9fe',
		accent: '#7c3aed',
		image: '/images/cases/labellio-1.png',
		relation: 'Acquired by Kyocera',
		summary: 'Built visual recognition and human-in-the-loop machine learning tooling.',
		href: '/cases/labellio/',
	},
	{
		id: 'systems',
		label: 'Systems Design',
		x: 512,
		y: 230,
		pillBg: '#d1fae5',
		accent: '#059669',
		icon: 'grid',
		relation: 'Infrastructure for Intelligence',
		summary: 'Component libraries, shared knowledge, and guardrails for people and AI agents.',
		href: '/cases/decision-router/',
	},
	{
		id: 'evals',
		label: 'Evaluation Thinking',
		x: 485,
		y: 374,
		pillBg: '#ccfbf1',
		accent: '#0d9488',
		image: '/images/cases/ai-evals-1.png',
		relation: 'Knowing What Good Looks Like',
		summary: 'Structured rubrics and experiments to verify whether AI features truly help users.',
		href: '/cases/ai-evals/',
	},
	{
		id: 'human-ai',
		label: 'Human-AI UX',
		x: 285,
		y: 386,
		pillBg: '#e0e7ff',
		accent: '#4f46e5',
		image: '/images/cases/epistemia-ux-chatbot-grounding.png',
		relation: 'Interaction Patterns',
		summary: 'Interfaces for calibration, grounding, and shared agency between people and models.',
		href: '/cases/epistemia-ux/',
	},
	{
		id: 'code',
		label: 'Hands-on Code',
		x: 108,
		y: 344,
		pillBg: '#ffedd5',
		accent: '#ea580c',
		image: '/images/cases/tablox-1.png',
		relation: 'Prototyping & Shipping',
		summary: 'Rapidly building working prototypes, browser tools, and production UI.',
		href: '/cases/tablox/',
	},
];

const kgEdges = [
	{ id: 'marcel-alpaca', from: 'marcel', to: 'alpaca', label: 'founding designer', color: '#d97706' },
	{ id: 'marcel-fintech', from: 'marcel', to: 'fintech', label: '10+ yrs across', color: '#0284c7' },
	{ id: 'marcel-labellio', from: 'marcel', to: 'labellio', label: 'co-built', color: '#7c3aed' },
	{ id: 'marcel-systems', from: 'marcel', to: 'systems', label: 'architects', color: '#059669' },
	{ id: 'marcel-human-ai', from: 'marcel', to: 'human-ai', label: 'shapes', color: '#4f46e5' },
	{ id: 'marcel-code', from: 'marcel', to: 'code', label: 'ships with', color: '#ea580c' },
	{ id: 'systems-evals', from: 'systems', to: 'evals', label: 'grounded in', color: '#0d9488' },
	{ id: 'evals-human-ai', from: 'evals', to: 'human-ai', label: 'validates', color: '#0d9488' },
];

const kgNodeMap = new Map(kgNodes.map((n) => [n.id, n]));
---

<Base title={site.siteTitle} description={site.siteDescription}>
	<!-- Hero Section: Full Viewport Bio + Interactive Knowledge Graph -->
	<section
		id="hero"
		data-snap-section="hero"
		class="snap-section is-in-view relative flex min-h-[calc(100svh-var(--header-h,84px))] flex-col justify-center bg-transparent pt-4 pb-6 md:pt-4 md:pb-8"
	>
		<div class="container-page relative z-10 flex flex-col items-center">
			<div
				data-reveal="fade"
				data-reveal-immediate
				class="grid w-full overflow-hidden rounded-[24px] border border-ink/12 bg-white/88 shadow-[0_14px_40px_rgba(3,74,67,0.08)] backdrop-blur-sm lg:h-[520px] lg:grid-cols-[1.02fr_1.18fr]"
			>
				<!-- Left: Short Bio & About with selectable phrases -->
				<div class="flex flex-col justify-between gap-6 border-b border-ink/10 p-6 sm:p-8 lg:border-r lg:border-b-0 lg:p-10">
					<div
						data-kg-bio
						class="space-y-4 font-serif text-[18px] leading-[1.72] text-ink/90 sm:text-[19px]"
					>
						<p>
							<button type="button" data-kg-trigger="marcel" data-kg-nodes="marcel" class="kg-token kg-token-rose">Marcel Akiyama</button>
							{' '}designs{' '}
							<button type="button" data-kg-trigger="systems" data-kg-nodes="systems,marcel" data-kg-edges="marcel-systems" class="kg-token kg-token-emerald">AI systems &amp; products</button>
							{' '}with 10+ years across{' '}
							<button type="button" data-kg-trigger="fintech" data-kg-nodes="fintech,marcel" data-kg-edges="marcel-fintech" class="kg-token kg-token-sky">fintech &amp; B2B SaaS</button>
							{' '}and{' '}
							<button type="button" data-kg-trigger="human-ai" data-kg-nodes="human-ai,marcel" data-kg-edges="marcel-human-ai" class="kg-token kg-token-indigo">human-AI UX</button>.
						</p>
						<p>
							Previously Founding Product Designer at{' '}
							<button type="button" data-kg-trigger="alpaca" data-kg-nodes="alpaca,marcel" data-kg-edges="marcel-alpaca" class="kg-token kg-token-amber">Alpaca (YC W19)</button>
							{' '}and co-builder of{' '}
							<button type="button" data-kg-trigger="labellio" data-kg-nodes="labellio,marcel" data-kg-edges="marcel-labellio" class="kg-token kg-token-violet">Labellio</button>
							{' '}(acquired by Kyocera). Today he connects{' '}
							<button type="button" data-kg-trigger="evals" data-kg-nodes="evals,systems,human-ai" data-kg-edges="systems-evals,evals-human-ai" class="kg-token kg-token-teal">evaluation thinking</button>,{' '}
							<button type="button" data-kg-trigger="systems" data-kg-nodes="systems,evals" data-kg-edges="marcel-systems,systems-evals" class="kg-token kg-token-emerald">systems design</button>,
							{' '}and{' '}
							<button type="button" data-kg-trigger="code" data-kg-nodes="code,marcel" data-kg-edges="marcel-code" class="kg-token kg-token-orange">hands-on code</button>
							{' '}to turn messy problems into clear direction.
						</p>
					</div>

					<!-- Hint + Active Node Detail Preview (fixed height to prevent layout shift) -->
					<div class="flex min-h-[84px] items-center border-t border-ink/10 pt-4">
						<p data-kg-hint class="font-mono text-[11px] tracking-wide text-muted">
							Select or click any highlighted phrase to explore the knowledge graph.
						</p>
						<div data-kg-detail class="hidden w-full items-center gap-3.5">
							<div class="h-12 w-12 shrink-0 overflow-hidden rounded-[10px] border border-ink/12 bg-mint-soft/50 flex items-center justify-center">
								<img data-kg-detail-img src="" alt="" class="hidden h-full w-full object-cover" />
								<span data-kg-detail-icon class="hidden text-teal-mid"></span>
							</div>
							<div class="min-w-0 flex-1">
								<p data-kg-detail-rel class="font-mono text-[10px] uppercase tracking-widest text-teal-mid"></p>
								<p data-kg-detail-title class="text-sm font-medium text-ink"></p>
								<p data-kg-detail-summary class="mt-0.5 text-xs leading-relaxed text-ink/75"></p>
							</div>
							<div class="flex shrink-0 items-center gap-2">
								<a
									data-kg-detail-link
									href="#"
									class="hidden rounded-[6px] border border-ink/20 px-3 py-1.5 font-mono text-[10px] uppercase tracking-wider text-ink transition-colors hover:bg-ink hover:text-white"
								>
									View &rarr;
								</a>
								<button
									type="button"
									data-kg-reset
									aria-label="Reset selection"
									class="hidden cursor-pointer rounded-full border border-ink/15 px-2.5 py-1 font-mono text-[10px] uppercase tracking-wider text-muted transition-colors hover:border-ink/40 hover:text-ink"
								>
									Reset
								</button>
							</div>
						</div>
					</div>
				</div>

				<!-- Right: Interactive Knowledge Graph -->
				<div class="bg-dot-grid relative min-h-[380px] overflow-hidden p-4 sm:min-h-[440px] lg:min-h-[480px]">
					<div class="pointer-events-none absolute top-4 left-5 z-10 flex items-center gap-2">
						<span class="h-2 w-2 rounded-full bg-teal-accent"></span>
						<span class="font-mono text-[10px] uppercase tracking-widest text-muted">
							Knowledge Graph
						</span>
					</div>

					<div data-kg-canvas class="relative h-full min-h-[360px] w-full sm:min-h-[420px] lg:min-h-[450px]">
						<svg
							viewBox="0 0 640 460"
							preserveAspectRatio="none"
							class="pointer-events-none absolute inset-0 h-full w-full"
							aria-hidden="true"
						>
							<defs>
								{kgEdges.map((edge) => (
									<marker
										id={`kg-arrow-${edge.id}`}
										viewBox="0 0 10 10"
										refX="8"
										refY="5"
										markerWidth="6"
										markerHeight="6"
										orient="auto-start-reverse"
									>
										<path d="M 0 1.5 L 9 5 L 0 8.5 z" fill={edge.color} />
									</marker>
								))}
							</defs>
							{kgEdges.map((edge) => {
								const from = kgNodeMap.get(edge.from)!;
								const to = kgNodeMap.get(edge.to)!;
								const dx = to.x - from.x;
								const dy = to.y - from.y;
								const dist = Math.hypot(dx, dy) || 1;
								const padStart = 32;
								const padEnd = 36;
								const x1 = from.x + (dx / dist) * padStart;
								const y1 = from.y + (dy / dist) * padStart;
								const x2 = to.x - (dx / dist) * padEnd;
								const y2 = to.y - (dy / dist) * padEnd;
								const mx = (x1 + x2) / 2;
								const my = (y1 + y2) / 2;
								return (
									<g
										data-kg-edge={edge.id}
										class="kg-edge transition-opacity duration-200"
									>
										<line
											x1={x1}
											y1={y1}
											x2={x2}
											y2={y2}
											stroke={edge.color}
											stroke-width="2"
											stroke-opacity="0.45"
											marker-end={`url(#kg-arrow-${edge.id})`}
										/>
										<rect
											x={mx - 44}
											y={my - 9}
											width="88"
											height="18"
											rx="9"
											fill="rgba(255,255,255,0.9)"
										/>
										<text
											x={mx}
											y={my + 3.5}
											text-anchor="middle"
											fill="#034a43"
											font-size="10"
											font-family="ui-monospace, SFMono-Regular, Menlo, monospace"
										>
											{edge.label}
										</text>
									</g>
								);
							})}
						</svg>

						{kgNodes.map((node) => (
							<button
								type="button"
								data-kg-node={node.id}
								data-kg-label={node.label}
								data-kg-rel={node.relation}
								data-kg-summary={node.summary}
								data-kg-img={node.image || ''}
								data-kg-icon={node.icon || ''}
								data-kg-href={node.href || ''}
								style={`left: ${(node.x / 640) * 100}%; top: ${(node.y / 460) * 100}%; --node-bg: ${node.pillBg}; --node-accent: ${node.accent};`}
								class="kg-node group absolute -translate-x-1/2 -translate-y-1/2 cursor-pointer select-none"
							>
								<span class="kg-node-badge">
									{node.image ? (
										<img
											src={node.image}
											alt={node.label}
											class="h-full w-full object-cover"
										/>
									) : node.icon === 'layers' ? (
										<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
											<polygon points="12 2 2 7 12 12 22 7 12 2" />
											<polyline points="2 17 12 22 22 17" />
											<polyline points="2 12 12 17 22 12" />
										</svg>
									) : (
										<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
											<rect x="3" y="3" width="7" height="7" rx="1.5" />
											<rect x="14" y="3" width="7" height="7" rx="1.5" />
											<rect x="14" y="14" width="7" height="7" rx="1.5" />
											<rect x="3" y="14" width="7" height="7" rx="1.5" />
										</svg>
									)}
								</span>
								<span class="kg-node-label">{node.label}</span>
							</button>
						))}
					</div>
				</div>
			</div>

			<!-- Subtle scroll cue inside hero flow so it scrolls away cleanly with hero -->
			<div class="mt-6 flex justify-center">
				<a
					href="#lenses"
					class="inline-flex items-center gap-2 rounded-full border border-ink/12 bg-white/75 px-4 py-1.5 font-mono text-[10px] uppercase tracking-widest text-ink/70 transition-colors hover:border-ink/30 hover:text-ink"
				>
					<span>Scroll to explore</span>
					<span aria-hidden="true">&darr;</span>
				</a>
			</div>
		</div>
	</section>

	<div data-hero-sheet class="relative z-10 pb-8 md:pb-12">
		<div class="container-page flex flex-col gap-6 md:gap-0">
			<!-- 3 Practice Pillars + USP -->
			<div id="lenses" data-snap-section="lenses" class="snap-section">
			<section
				aria-labelledby="pillars-heading"
				class="overflow-hidden rounded-[24px] border border-teal-border/60 bg-teal-dark px-6 py-10 text-mint-soft shadow-[0_12px_36px_rgba(3,74,67,0.14)] sm:px-10 md:px-12 md:py-12"
			>
				<div class="border-b border-teal-accent/15 pb-4">
					<h2 id="pillars-heading" class="section-eyebrow text-teal-accent" data-i18n="pillars.heading">
						Three lenses behind the work
					</h2>
				</div>

				<div class="mt-7 grid gap-5 md:grid-cols-3 md:gap-6">
					{
						pillars.map((pillar) => (
							<button
								type="button"
								data-pillar-open={pillar.id}
								class="group flex cursor-pointer flex-col overflow-hidden rounded-[18px] border border-teal-accent/15 bg-forest-deep/75 text-left transition-[transform,border-color,box-shadow] duration-250 hover:-translate-y-1 hover:border-teal-accent/40 hover:shadow-[0_16px_34px_rgba(2,18,18,0.28)]"
							>
								<div class="relative h-[212px] w-full overflow-hidden">
									<span class="pointer-events-none absolute top-3.5 left-5 z-10 font-mono text-[11px] uppercase tracking-widest text-teal-accent/85">
										{pillar.number}
									</span>
									<canvas
										data-pillar-icon={pillar.iconSrc}
										class="block h-full w-full"
										aria-hidden="true"
									></canvas>
								</div>

								<div class="flex-1 border-t border-teal-accent/15 bg-teal-mid/40 px-6 py-5 transition-colors duration-250 group-hover:bg-teal-mid/55">
									<h3 class="text-xl font-medium tracking-tight text-white" data-i18n={`${pillar.i18nPrefix}.title`}>
										{pillar.title}
									</h3>
									<p class="mt-1.5 font-serif text-base leading-relaxed text-mint-soft/85" data-i18n={`${pillar.i18nPrefix}.tagline`}>
										{pillar.tagline}
									</p>
								</div>
							</button>
						))
					}
				</div>
			</section>
			</div>

			<!-- Featured Case Studies -->
			<div id="cases" data-snap-section="cases" class="snap-section">
			<section
				class="bg-dot-grid overflow-hidden rounded-[24px] border border-ink/10 px-6 pt-10 pb-[64px] shadow-[0_12px_36px_rgba(3,74,67,0.08)] sm:px-10 md:px-12"
			>
				<div class="flex flex-col gap-[39px]">
				<!-- Section Header -->
				<div class="flex items-center justify-between gap-4 border-b border-ink/25 py-[17px]">
					<h2 class="section-eyebrow text-ink" data-reveal="words" data-reveal-immediate data-i18n="featured.heading">
						{site.featuredHeading}
					</h2>
					<a
						href="/cases/"
						data-reveal="fade"
						data-reveal-immediate
						data-i18n="common.seeAll"
						class="rounded-[6px] border border-ink px-8 py-1.5 text-sm font-normal text-ink transition-colors hover:bg-ink hover:text-white sm:px-10"
					>
						See All
					</a>
				</div>

				<!-- 3-Column Framer Cards -->
				<div
					class="grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3"
					data-reveal="scale"
					data-reveal-immediate
				>
					{
						featuredCases.map((entry) => (
							<a href={`/cases/${entry.id}/`} class="framer-case-card group">
								<div class="framer-case-thumb">
									<img
										src={entry.data.coverImage}
										alt={entry.data.coverAlt || entry.data.title}
										loading="lazy"
									/>
								</div>
								<div class="flex flex-col gap-2.5">
									{entry.data.tag && (
										<p
											data-i18n={`case.${entry.id}.meta`}
											class="font-mono text-[11px] uppercase tracking-wider text-muted"
										>
											{entry.data.tag} &middot; {entry.data.timeline}
										</p>
									)}
									<h3
										data-i18n={`case.${entry.id}.title`}
										class="text-2xl font-medium leading-snug text-ink transition-colors group-hover:text-teal-mid"
									>
										{entry.data.title}
									</h3>
									<p
										data-i18n={`case.${entry.id}.subtitle`}
										class="font-serif text-base leading-[1.6] text-ink"
									>
										{entry.data.subtitle}
									</p>
								</div>
							</a>
						))
					}
				</div>
			</div>
		</section>
		</div>

		<!-- Journal Section -->
		<div id="journal" data-snap-section="journal" class="snap-section">
		<section class="overflow-hidden rounded-[24px] border border-teal-border/80 bg-forest-deep px-6 py-[56px] pb-[72px] text-teal-accent shadow-[0_12px_36px_rgba(2,18,18,0.16)] sm:px-10 md:px-12">
			<div>
				<div class="flex items-center justify-between gap-4 border-b border-teal-border py-[17px]">
					<h2 class="section-eyebrow text-teal-accent" data-reveal="words" data-i18n="journal.heading">
						{site.journalHeading}
					</h2>
					<a
						href={site.journalUrl}
						target="_blank"
						rel="noopener noreferrer"
						data-reveal="fade"
