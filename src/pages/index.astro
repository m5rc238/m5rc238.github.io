---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import site from '../data/site.json';

const allCases = await getCollection('cases');
const featuredCases = allCases
	.filter((c) => c.data.featured)
	.sort((a, b) => a.data.order - b.data.order);

const journalPosts = (await getCollection('journal')).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<Base title={site.siteTitle} description={site.siteDescription}>
	<!-- Hero Section -->
	<section class="bg-mint py-16 md:py-24">
		<div class="container-page flex flex-col gap-8">
			<div class="flex items-center gap-4">
				<img
					src={site.hero.avatar}
					alt={site.name}
					width="64"
					height="64"
					class="h-16 w-16 rounded-full object-cover shadow-[inset_0_8px_6px_-3px_rgba(242,208,208,0.5)]"
				/>
				<p class="text-lg font-medium text-ink md:text-xl">
					{site.hero.greeting}
				</p>
			</div>

			<h1 class="max-w-[26ch] text-3xl font-light leading-[1.3] tracking-tight text-ink md:text-[2.3125rem]">
				{site.hero.bio}
			</h1>
		</div>
	</section>

	<!-- Featured Case Studies -->
	<section class="py-20 md:py-24">
		<div class="container-page">
			<div class="flex items-center justify-between gap-4">
				<h2 class="section-eyebrow text-teal-dark">
					{site.featuredHeading}
				</h2>
				<a
					href="/cases/"
					class="inline-flex items-center gap-1.5 text-sm font-medium text-teal-dark transition-colors hover:text-teal-mid"
				>
					See All
					<span aria-hidden="true">&rarr;</span>
				</a>
			</div>

			<div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{
					featuredCases.map((entry) => (
						<a href={`/cases/${entry.id}/`} class="case-card group flex flex-col">
							<div class="aspect-16/11 w-full overflow-hidden bg-white">
								<img
									src={entry.data.coverImage}
									alt={entry.data.coverAlt || entry.data.title}
									loading="lazy"
									class="h-full w-full object-cover"
								/>
							</div>
							<div class="flex flex-1 flex-col gap-2 p-5">
								<h3 class="text-lg font-semibold tracking-tight text-forest-deep group-hover:text-teal-dark">
									{entry.data.title}
								</h3>
								<p class="text-sm leading-relaxed text-muted">
									{entry.data.subtitle}
								</p>
							</div>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<!-- Journal Section -->
	<section class="bg-forest py-20 text-white md:py-24">
		<div class="container-page">
			<div class="flex items-center justify-between gap-4">
				<h2 class="section-eyebrow text-teal-accent">
					{site.journalHeading}
				</h2>
				<a
					href={site.journalUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-1.5 text-sm font-medium text-mint-soft/80 transition-colors hover:text-teal-accent"
				>
					Substack
					<span aria-hidden="true">&nearr;</span>
				</a>
			</div>

			<ul class="mt-8 divide-y divide-teal-accent/15 border-y border-teal-accent/15">
				{
					journalPosts.map((post) => (
						<li>
							<a
								href={post.data.url}
								target="_blank"
								rel="noopener noreferrer"
								class="group flex flex-col justify-between gap-2 py-6 transition-colors sm:flex-row sm:items-baseline sm:gap-8"
							>
								<span class="text-lg font-medium text-mint-soft transition-colors group-hover:text-teal-accent group-hover:underline group-hover:underline-offset-4 md:text-xl">
									{post.data.title}
								</span>
								<span class="shrink-0 font-mono text-xs tracking-wider text-teal-accent/70">
									{post.data.date}
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- Experience Section -->
	<section class="bg-mint py-20 md:py-24">
		<div class="container-page flex flex-col gap-8">
			<h2 class="section-eyebrow text-teal-dark">
				{site.experience.heading}
			</h2>

			<div class="overflow-hidden rounded-2xl bg-white/40 p-4 md:p-6">
				<img
					src={site.experience.bannerImage}
					alt={site.experience.bannerAlt}
					loading="lazy"
					class="h-auto w-full object-contain"
				/>
			</div>

			<p class="max-w-[54ch] text-lg leading-relaxed text-forest-deep md:text-xl">
				{site.experience.summary}
			</p>
		</div>
	</section>
</Base>
