					<div class="flex shrink-0 flex-wrap items-center gap-2.5">
						<a
							href={`mailto:${site.email}`}
							data-i18n="cta.button"
							class="inline-flex items-center justify-center rounded-[6px] bg-teal-accent px-5 py-2 text-sm font-medium text-obsidian transition-colors hover:bg-mint-soft"
						>
							{site.cta.buttonLabel}
						</a>
						<button
							type="button"
							data-copy-email={site.email}
							class="inline-flex cursor-pointer items-center justify-center rounded-[6px] border border-teal-accent/40 px-4 py-2 text-sm font-normal text-mint-soft transition-colors hover:border-teal-accent hover:bg-teal-accent/10"
						>
							<span data-copy-label data-i18n="cta.copy">Copy email</span>
						</button>
					</div>
				</div>
			</dialog>
		))
	}

	<script>
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const iconCanvases = document.querySelectorAll<HTMLCanvasElement>('[data-pillar-icon]');

		interface Dot {
			u: number;
			v: number;
			r: number;
			g: number;
			b: number;
			a: number;
			lum: number;
			phase: number;
		}

		const extractDots = (img: HTMLImageElement, grid = 44): Dot[] => {
			const off = document.createElement('canvas');
			off.width = grid;
			off.height = grid;
			const octx = off.getContext('2d');
			if (!octx) return [];

			octx.drawImage(img, 0, 0, grid, grid);
			const data = octx.getImageData(0, 0, grid, grid).data;

			// Sample top-left corner as dark background key color
			const r0 = data[0];
			const g0 = data[1];
			const b0 = data[2];

			const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
			const mixColor = (
				c1: [number, number, number],
				c2: [number, number, number],
				t: number,
			): [number, number, number] => [
				Math.round(lerp(c1[0], c2[0], t)),
				Math.round(lerp(c1[1], c2[1], t)),
				Math.round(lerp(c1[2], c2[2], t)),
			];

			// Page palette stops: teal-mid (#06635a) -> teal-accent (#0ce8aa) -> mint-soft (#c9fff0)
			const cLow: [number, number, number] = [6, 99, 90];
			const cMid: [number, number, number] = [12, 232, 170];
			const cHigh: [number, number, number] = [201, 255, 240];

			const rawDots: Array<Dot & { gx: number; gy: number }> = [];
			let minX = grid;
			let maxX = 0;
			let minY = grid;
			let maxY = 0;

			for (let y = 0; y < grid; y++) {
				for (let x = 0; x < grid; x++) {
					const idx = (y * grid + x) * 4;
					const r = data[idx];
					const g = data[idx + 1];
					const b = data[idx + 2];

					const dr = r - r0;
					const dg = g - g0;
					const db = b - b0;
					const dist = Math.sqrt(dr * dr + dg * dg + db * db);

					if (dist < 28) continue;
					const alpha = dist < 56 ? (dist - 28) / (56 - 28) : 1;
					const lum = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
					const tone = Math.min(1, Math.max(0, (lum - 0.12) / 0.78));
					const [mr, mg, mb] =
						tone < 0.55
							? mixColor(cLow, cMid, tone / 0.55)
							: mixColor(cMid, cHigh, (tone - 0.55) / 0.45);

					if (x < minX) minX = x;
					if (x > maxX) maxX = x;
					if (y < minY) minY = y;
					if (y > maxY) maxY = y;

					rawDots.push({
						gx: x + 0.5,
						gy: y + 0.5,
						u: 0,
						v: 0,
						r: mr,
						g: mg,
						b: mb,
						a: alpha,
						lum,
						phase: (x * 0.37 + y * 0.53) % (Math.PI * 2),
					});
				}
			}

			if (rawDots.length === 0) return [];
			const span = Math.max(maxX - minX + 1, maxY - minY + 1, 1);
			const cx = (minX + maxX + 1) * 0.5;
			const cy = (minY + maxY + 1) * 0.5;
			const fillRatio = 0.82;

			return rawDots.map(({ gx, gy, ...rest }) => ({
				...rest,
				u: 0.5 + ((gx - cx) / span) * fillRatio,
				v: 0.5 + ((gy - cy) / span) * fillRatio,
			}));
		};

		const cleanups: Array<() => void> = [];

		for (const canvas of iconCanvases) {
			const src = canvas.dataset.pillarIcon;
			const ctx = canvas.getContext('2d');
			if (!src || !ctx) continue;

			const img = new Image();
			img.src = src;
			img.decoding = 'async';

			let dots: Dot[] = [];
			let w = 0;
			let h = 0;
			let dpr = 1;
			let rafId = 0;
			let isVisible = true;
			const pointer = { x: -999, y: -999, active: false };

			const resize = () => {
				dpr = Math.min(window.devicePixelRatio || 1, 2);
				w = canvas.clientWidth || 300;
				h = canvas.clientHeight || 168;
				canvas.width = Math.floor(w * dpr);
				canvas.height = Math.floor(h * dpr);
				ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			};

			const draw = (now: number) => {
				if (!w || !h || dots.length === 0) return;
				ctx.clearRect(0, 0, w, h);

				const t = now * 0.0018;
				const size = Math.min(w, h) * 0.92;
				const ox = (w - size) * 0.5;
				const oy = (h - size) * 0.5;
				const baseMaxR = (size / 36) * 0.44;

				for (const d of dots) {
					const px = ox + d.u * size;
					const py = oy + d.v * size;

					const wave = reducedMotion ? 1 : 0.86 + 0.14 * Math.sin(t + d.phase);
					let hoverBoost = 0;
					if (pointer.active) {
						const dx = pointer.x - px;
						const dy = pointer.y - py;
						const dist = Math.sqrt(dx * dx + dy * dy);
						if (dist < 56) hoverBoost = (1 - dist / 56) * 0.45;
					}

					const rad = baseMaxR * (0.42 + 0.58 * d.lum) * wave * (1 + hoverBoost);
					if (rad < 0.35) continue;

					ctx.fillStyle = `rgba(${d.r}, ${d.g}, ${d.b}, ${(d.a * (0.85 + hoverBoost * 0.15)).toFixed(3)})`;
					ctx.beginPath();
					ctx.arc(px, py, rad, 0, Math.PI * 2);
					ctx.fill();
				}
			};

			const loop = (now: number) => {
				if (isVisible && !document.hidden) {
					draw(now);
				}
				if (!reducedMotion) {
					rafId = requestAnimationFrame(loop);
				}
			};

			const init = () => {
				dots = extractDots(img, 44);
				resize();
				draw(performance.now());
				if (!reducedMotion) {
					rafId = requestAnimationFrame(loop);
				}
			};

			if (img.complete && img.naturalWidth > 0) {
				init();
			} else {
				img.addEventListener('load', init, { once: true });
			}

			const onMove = (e: PointerEvent) => {
				const rect = canvas.getBoundingClientRect();
				pointer.x = e.clientX - rect.left;
				pointer.y = e.clientY - rect.top;
				pointer.active = true;
			};

			const onLeave = () => {
				pointer.active = false;
			};

			const card = canvas.closest('button');
			card?.addEventListener('pointermove', onMove, { passive: true });
			card?.addEventListener('pointerleave', onLeave, { passive: true });

			const ro = new ResizeObserver(() => {
				resize();
				draw(performance.now());
			});
			ro.observe(canvas);

			const io = new IntersectionObserver(
				(entries) => {
					isVisible = entries[0]?.isIntersecting ?? true;
				},
				{ rootMargin: '120px 0px' },
			);
			io.observe(canvas);

			cleanups.push(() => {
				if (rafId) cancelAnimationFrame(rafId);
				ro.disconnect();
				io.disconnect();
				card?.removeEventListener('pointermove', onMove);
				card?.removeEventListener('pointerleave', onLeave);
			});
		}

		window.addEventListener(
			'pagehide',
			() => {
				for (const fn of cleanups) fn();
			},
			{ once: true },
		);

		const openButtons = document.querySelectorAll<HTMLButtonElement>('[data-pillar-open]');
		for (const btn of openButtons) {
			btn.addEventListener('click', () => {
				const id = btn.dataset.pillarOpen;
				const dialog = id
					? document.querySelector<HTMLDialogElement>(`#pillar-modal-${id}`)
					: null;
				dialog?.showModal();
			});
		}

		const dialogs = document.querySelectorAll<HTMLDialogElement>('[data-pillar-dialog]');
		for (const dialog of dialogs) {
			const closeBtn = dialog.querySelector<HTMLButtonElement>('[data-pillar-close]');
			closeBtn?.addEventListener('click', () => dialog.close());
			dialog.addEventListener('click', (e) => {
				if (e.target === dialog) dialog.close();
			});
		}

		// Interactive Bio + Knowledge Graph
		const kgBio = document.querySelector<HTMLElement>('[data-kg-bio]');
		const kgTriggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-kg-trigger]'));
		const kgNodes = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-kg-node]'));
		const kgEdges = Array.from(document.querySelectorAll<SVGGElement>('[data-kg-edge]'));
		const kgResetBtn = document.querySelector<HTMLButtonElement>('[data-kg-reset]');
		const kgHint = document.querySelector<HTMLElement>('[data-kg-hint]');
		const kgDetail = document.querySelector<HTMLElement>('[data-kg-detail]');
		const kgDetailImg = document.querySelector<HTMLImageElement>('[data-kg-detail-img]');
		const kgDetailIcon = document.querySelector<HTMLElement>('[data-kg-detail-icon]');
		const kgDetailRel = document.querySelector<HTMLElement>('[data-kg-detail-rel]');
		const kgDetailTitle = document.querySelector<HTMLElement>('[data-kg-detail-title]');
		const kgDetailSummary = document.querySelector<HTMLElement>('[data-kg-detail-summary]');
		const kgDetailLink = document.querySelector<HTMLAnchorElement>('[data-kg-detail-link]');

		const iconSvgs: Record<string, string> = {
			layers: '<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>',
			grid: '<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/></svg>',
		};

		let lockedPrimary: string | null = null;

		const applyGraphHighlight = (
			primaryId: string | null,
			nodeIds: Set<string>,
			edgeIds: Set<string>,
		) => {
			const hasActive = nodeIds.size > 0;

			for (const trigger of kgTriggers) {
				const trigPrimary = trigger.dataset.kgTrigger || '';
				const trigNodes = (trigger.dataset.kgNodes || '').split(',').filter(Boolean);
				const isMatch =
					hasActive &&
					(trigPrimary === primaryId || (primaryId !== null && trigNodes.includes(primaryId)));
				trigger.classList.toggle('is-active', isMatch);
				trigger.classList.toggle('is-dimmed', hasActive && !isMatch);
			}

			for (const node of kgNodes) {
				const id = node.dataset.kgNode || '';
				const isActive = hasActive && nodeIds.has(id);
				node.classList.toggle('is-active', isActive);
				node.classList.toggle('is-primary', id === primaryId);
				node.classList.toggle('is-dimmed', hasActive && !isActive);
			}

			for (const edge of kgEdges) {
				const id = edge.dataset.kgEdge || '';
				const isActive = hasActive && edgeIds.has(id);
				edge.classList.toggle('is-active', isActive);
				edge.classList.toggle('is-dimmed', hasActive && !isActive);
			}

			kgResetBtn?.classList.toggle('hidden', !lockedPrimary);

			const primaryNode = primaryId
				? kgNodes.find((n) => n.dataset.kgNode === primaryId)
				: null;

			if (primaryNode && kgDetail && kgHint) {
				kgHint.classList.add('hidden');
				kgDetail.classList.remove('hidden');
				kgDetail.classList.add('flex');

				const img = primaryNode.dataset.kgImg || '';
				const icon = primaryNode.dataset.kgIcon || '';
				const href = primaryNode.dataset.kgHref || '';

				if (kgDetailImg && kgDetailIcon) {
					if (img) {
						kgDetailImg.src = img;
						kgDetailImg.alt = primaryNode.dataset.kgLabel || '';
						kgDetailImg.classList.remove('hidden');
						kgDetailIcon.classList.add('hidden');
					} else {
						kgDetailImg.classList.add('hidden');
						kgDetailIcon.innerHTML = iconSvgs[icon] || iconSvgs.grid;
						kgDetailIcon.classList.remove('hidden');
					}
				}

				if (kgDetailRel) kgDetailRel.textContent = primaryNode.dataset.kgRel || '';
				if (kgDetailTitle) kgDetailTitle.textContent = primaryNode.dataset.kgLabel || '';
				if (kgDetailSummary) kgDetailSummary.textContent = primaryNode.dataset.kgSummary || '';
				if (kgDetailLink) {
					if (href) {
						kgDetailLink.href = href;
						kgDetailLink.classList.remove('hidden');
					} else {
						kgDetailLink.classList.add('hidden');
					}
				}
			} else if (kgDetail && kgHint) {
				kgDetail.classList.add('hidden');
				kgDetail.classList.remove('flex');
				kgHint.classList.remove('hidden');
			}
		};

		const highlightFromTrigger = (trigger: HTMLButtonElement) => {
			const primaryId = trigger.dataset.kgTrigger || null;
			const nodes = new Set((trigger.dataset.kgNodes || '').split(',').filter(Boolean));
			const edges = new Set((trigger.dataset.kgEdges || '').split(',').filter(Boolean));
			applyGraphHighlight(primaryId, nodes, edges);
		};

		const highlightFromNode = (nodeId: string) => {
			const connectedNodes = new Set<string>([nodeId]);
			const connectedEdges = new Set<string>();
			for (const edge of kgEdges) {
				const id = edge.dataset.kgEdge || '';
				const parts = id.split('-');
				if (id.startsWith(`${nodeId}-`) || id.endsWith(`-${nodeId}`) || parts.includes(nodeId)) {
					connectedEdges.add(id);
					for (const n of kgNodes) {
						const nid = n.dataset.kgNode || '';
						if (nid && id.includes(nid)) connectedNodes.add(nid);
					}
				}
			}
			applyGraphHighlight(nodeId, connectedNodes, connectedEdges);
		};

		const resetGraph = () => {
			lockedPrimary = null;
			applyGraphHighlight(null, new Set(), new Set());
		};

		for (const trigger of kgTriggers) {
			trigger.addEventListener('click', () => {
				const id = trigger.dataset.kgTrigger || null;
				if (lockedPrimary === id) {
					resetGraph();
				} else {
					lockedPrimary = id;
					highlightFromTrigger(trigger);
				}
			});

			trigger.addEventListener('mouseenter', () => {
				if (!lockedPrimary) highlightFromTrigger(trigger);
			});

			trigger.addEventListener('mouseleave', () => {
				if (!lockedPrimary) applyGraphHighlight(null, new Set(), new Set());
			});
		}

		for (const node of kgNodes) {
			const id = node.dataset.kgNode || '';
			node.addEventListener('click', () => {
				if (lockedPrimary === id) {
					resetGraph();
				} else {
					lockedPrimary = id;
					highlightFromNode(id);
				}
			});
		}

		kgResetBtn?.addEventListener('click', resetGraph);

		// Support real text selection inside the bio paragraph
		const handleBioSelection = () => {
			if (!kgBio) return;
			const sel = window.getSelection();
			if (!sel || sel.isCollapsed || sel.rangeCount === 0) return;
			const range = sel.getRangeAt(0);
			if (!kgBio.contains(range.commonAncestorContainer)) return;

			const matchedNodes = new Set<string>();
			const matchedEdges = new Set<string>();
			let firstPrimary: string | null = null;

			for (const trigger of kgTriggers) {
				if (sel.containsNode(trigger, true)) {
					if (!firstPrimary) firstPrimary = trigger.dataset.kgTrigger || null;
					for (const n of (trigger.dataset.kgNodes || '').split(',')) {
						if (n) matchedNodes.add(n);
					}
					for (const e of (trigger.dataset.kgEdges || '').split(',')) {
						if (e) matchedEdges.add(e);
					}
				}
			}

			if (matchedNodes.size > 0) {
				lockedPrimary = firstPrimary;
				applyGraphHighlight(firstPrimary, matchedNodes, matchedEdges);
			}
		};

		kgBio?.addEventListener('mouseup', handleBioSelection);
		kgBio?.addEventListener('keyup', handleBioSelection);

		// One-section-at-a-time snap + active focus observer
		const snapSections = Array.from(document.querySelectorAll<HTMLElement>('[data-snap-section]'));
		const snapDots = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-snap-dot]'));

		if (snapSections.length > 0 && !reducedMotion) {
			document.documentElement.classList.add('has-snap-sections');

			const setActiveSection = (activeId: string) => {
				for (const sec of snapSections) {
					sec.classList.toggle('is-in-view', sec.dataset.snapSection === activeId);
				}
				for (const dot of snapDots) {
					const isActive = dot.dataset.snapDot === activeId;
					dot.classList.toggle('is-active', isActive);
					if (isActive) {
						dot.setAttribute('aria-current', 'location');
					} else {
						dot.removeAttribute('aria-current');
					}
				}
			};

			const syncActiveSection = () => {
				const midY = window.innerHeight * 0.45;
				if (window.scrollY < (snapSections[0]?.offsetHeight || 600) * 0.45) {
					setActiveSection('hero');
					return;
				}
				let activeId = 'lenses';
				let bestDist = Infinity;
				for (const sec of snapSections) {
					const id = sec.dataset.snapSection || '';
					if (!id || id === 'hero') continue;
					const rect = sec.getBoundingClientRect();
					const center = rect.top + rect.height * 0.5;
					const dist = Math.abs(center - midY);
					if (dist < bestDist) {
						bestDist = dist;
						activeId = id;
					}
				}
				setActiveSection(activeId);
			};

			let snapTicking = false;
			const onSnapScroll = () => {
				if (!snapTicking) {
					snapTicking = true;
					requestAnimationFrame(() => {
						snapTicking = false;
						syncActiveSection();
					});
				}
			};

			syncActiveSection();
			window.addEventListener('scroll', onSnapScroll, { passive: true });
			cleanups.push(() => {
				window.removeEventListener('scroll', onSnapScroll);
				document.documentElement.classList.remove('has-snap-sections');
			});
		} else {
			for (const sec of snapSections) sec.classList.add('is-in-view');
		}
	</script>
</Base>
