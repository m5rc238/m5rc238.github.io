---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
---

<Base
	title={`Terms & Conditions | ${site.name}`}
	description={`Terms and conditions for ${site.name}'s portfolio website.`}
	bodyClass="bg-dot-grid"
>
	<article class="py-14 md:py-20">
		<div class="container-page max-w-3xl">
			<a
				href="/"
				class="inline-flex items-center gap-1.5 text-sm font-medium text-teal-dark transition-colors hover:text-teal-mid"
			>
				<span aria-hidden="true">&larr;</span>
				Home
			</a>

			<header class="mt-8 border-b border-ink/15 pb-6">
				<p class="section-eyebrow text-teal-mid">Legal</p>
				<h1 class="mt-3 text-3xl font-medium leading-[1.12] tracking-tight text-ink md:text-5xl">
					Terms &amp; Conditions
				</h1>
				<p class="mt-3 font-mono text-xs uppercase tracking-wider text-muted">
					Last updated: November 25, 2026
				</p>
			</header>

			<div class="mt-10 space-y-8 font-serif text-base leading-[1.75] text-ink md:text-lg">
				<section class="space-y-3">
					<h2 class="font-sans text-xl font-medium tracking-tight text-ink">Use of This Site</h2>
					<p>
						This website showcases product design, research, and engineering work by{' '}
						{site.name}. By browsing this site, you agree to use its content for lawful,
						informational, and evaluation purposes only.
					</p>
				</section>

				<section class="space-y-3">
					<h2 class="font-sans text-xl font-medium tracking-tight text-ink">Intellectual Property</h2>
					<p>
						Unless otherwise noted (such as open-source repositories linked from case
						studies under their respective licenses), all text, visuals, case studies, and
						original designs on this site remain the property of {site.name} or the
						respective client organizations featured.
					</p>
				</section>

				<section class="space-y-3">
					<h2 class="font-sans text-xl font-medium tracking-tight text-ink">
						External Links &amp; Demos
					</h2>
					<p>
						Case studies may link to live prototypes, benchmarks, or third-party websites.
						All demos and informational materials are provided &ldquo;as is&rdquo; without
						warranties of any kind, and external sites are governed by their own terms.
					</p>
				</section>

				<section class="space-y-3">
					<h2 class="font-sans text-xl font-medium tracking-tight text-ink">Contact</h2>
					<p>
						Questions about these terms or permissions to reuse material can be sent to{' '}
						<a
							href={`mailto:${site.email}`}
							class="font-medium text-teal-dark underline decoration-ink/30 underline-offset-4 hover:text-teal-mid"
						>
							{site.email}
						</a>.
					</p>
				</section>
			</div>
		</div>
	</article>
</Base>
