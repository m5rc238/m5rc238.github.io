---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ImageLightbox from '../../components/ImageLightbox.astro';
import site from '../../data/site.json';

export async function getStaticPaths() {
	const cases = await getCollection('cases');
	return cases.map((entry) => ({
		params: { slug: entry.id },
		props: { entry, allCases: cases },
	}));
}

const { entry, allCases } = Astro.props;
const { Content, headings } = await render(entry);
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const hasToc = tocHeadings.length >= 2;

const prevCase = entry.data.prevSlug
	? allCases.find((c) => c.id === entry.data.prevSlug)
	: undefined;
const nextCase = entry.data.nextSlug
	? allCases.find((c) => c.id === entry.data.nextSlug)
	: undefined;
---

<Base
	title={`${entry.data.title} | ${site.name}`}
	description={entry.data.subtitle}
	bodyClass="bg-dot-grid"
>
	<article class="py-14 md:py-20">
		<div class:list={['container-page', hasToc ? 'max-w-6xl' : 'max-w-4xl']}>
			<div class={hasToc ? 'max-w-4xl' : ''}>
			<a
				href="/cases/"
				class="inline-flex items-center gap-1.5 text-sm font-medium text-teal-dark transition-colors hover:text-teal-mid"
			>
				<span aria-hidden="true">&larr;</span>
				All Case Studies
			</a>

			<header class="mt-8">
				<h1 class="text-3xl font-medium leading-[1.12] tracking-tight text-ink md:text-5xl">
					{entry.data.title}
				</h1>
				<p class="mt-4 font-serif text-lg leading-relaxed text-muted md:text-xl">
					{entry.data.subtitle}
				</p>

				<dl class="mt-8 grid grid-cols-2 gap-6 border-y border-ink/15 py-6 text-sm sm:grid-cols-4">
					<div>
						<dt class="font-mono text-xs uppercase tracking-wider text-muted">Role</dt>
						<dd class="mt-1 font-medium text-ink">{entry.data.role}</dd>
					</div>
					<div>
						<dt class="font-mono text-xs uppercase tracking-wider text-muted">Scope</dt>
						<dd class="mt-1 font-medium text-ink">{entry.data.scope}</dd>
					</div>
					<div>
						<dt class="font-mono text-xs uppercase tracking-wider text-muted">Timeline</dt>
						<dd class="mt-1 font-medium text-ink">{entry.data.timeline}</dd>
					</div>
					<div>
						<dt class="font-mono text-xs uppercase tracking-wider text-muted">Team</dt>
						<dd class="mt-1 font-medium text-ink">{entry.data.team}</dd>
					</div>
				</dl>

				{
					(entry.data.summary || entry.data.liveUrl || entry.data.repoUrl) && (
						<div class="mt-6 flex flex-col gap-4 rounded-[8px] border border-ink/12 bg-white/85 px-5 py-4 sm:px-6 sm:py-5">
							{entry.data.summary && (
								<div>
									<p class="font-mono text-[11px] uppercase tracking-wider text-muted">
										{entry.data.tag ? `At a glance · ${entry.data.tag}` : 'At a glance'}
									</p>
									<p class="mt-1.5 font-serif text-base leading-relaxed text-ink">
										{entry.data.summary}
									</p>
								</div>
							)}
							{(entry.data.liveUrl || entry.data.repoUrl) && (
								<div class="flex flex-wrap items-center gap-3">
									{entry.data.liveUrl && (
										<a
											href={entry.data.liveUrl}
											target="_blank"
											rel="noopener noreferrer"
											class="inline-flex items-center gap-1.5 rounded-[6px] bg-ink px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-teal-mid"
										>
											Live Demo <span aria-hidden="true">&nearr;</span>
										</a>
									)}
									{entry.data.repoUrl && (
										<a
											href={entry.data.repoUrl}
											target="_blank"
											rel="noopener noreferrer"
											class="inline-flex items-center gap-1.5 rounded-[6px] border border-ink/25 bg-white px-4 py-2 text-sm font-medium text-ink transition-colors hover:border-ink hover:bg-mint/30"
										>
											GitHub Repo <span aria-hidden="true">&nearr;</span>
										</a>
									)}
								</div>
							)}
						</div>
					)
				}
			</header>

			{
				entry.data.youtubeId && (
					<div class="mt-10 aspect-video overflow-hidden rounded-[8px] border border-ink/12 bg-obsidian">
						<iframe
							src={`https://www.youtube-nocookie.com/embed/${entry.data.youtubeId}`}
							title={`${entry.data.title} video`}
							loading="lazy"
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
							allowfullscreen
							class="h-full w-full border-0"
						/>
					</div>
				)
			}
			</div>

			{hasToc && (
				<details class="mt-8 rounded-[10px] border border-ink/12 bg-white/85 px-5 py-3.5 lg:hidden">
					<summary class="cursor-pointer font-mono text-xs uppercase tracking-widest text-teal-mid select-none">
						Table of Contents
					</summary>
					<nav aria-label="Table of contents" class="mt-3 border-t border-ink/10 pt-3">
						<ul class="space-y-2 text-sm">
							{tocHeadings.map((h) => (
								<li class={h.depth === 3 ? 'pl-4' : ''}>
									<a
										href={`#${h.slug}`}
										class="block text-ink/80 transition-colors hover:text-teal-mid"
									>
										{h.text}
									</a>
								</li>
							))}
						</ul>
					</nav>
				</details>
			)}

			<div class:list={['mt-12', hasToc && 'lg:grid lg:grid-cols-[minmax(0,1fr)_240px] lg:items-start lg:gap-14']}>
				<div class="case-prose min-w-0">
					<Content />
				</div>

				{hasToc && (
					<aside class="hidden lg:sticky lg:top-28 lg:block">
						<div class="rounded-[12px] border border-ink/10 bg-white/75 p-5 backdrop-blur-xs">
							<p class="font-mono text-[11px] uppercase tracking-widest text-teal-mid">
								On this page
							</p>
							<nav aria-label="Table of contents" class="mt-3.5">
								<ul class="space-y-1 border-l border-ink/12 text-[13px] leading-snug">
									{tocHeadings.map((h, idx) => (
										<li>
											<a
												href={`#${h.slug}`}
												data-toc-link={h.slug}
												class:list={[
													'-ml-px block border-l-2 py-1.5 transition-colors',
													h.depth === 3 ? 'pl-6 text-xs' : 'pl-3.5',
													idx === 0
														? 'border-teal-mid font-medium text-ink'
														: 'border-transparent text-muted hover:border-ink/30 hover:text-ink',
												]}
											>
												{h.text}
											</a>
										</li>
									))}
								</ul>
							</nav>
						</div>
					</aside>
				)}
			</div>

			{(prevCase || nextCase) && (
				<nav
					aria-label="Case study pagination"
					class:list={[
						'mt-16 grid gap-4 border-t border-ink/15 pt-10 sm:grid-cols-2',
						hasToc && 'max-w-4xl',
					]}
				>
					<div>
						{prevCase && (
							<a
								href={`/cases/${prevCase.id}/`}
								class="group flex flex-col gap-1 rounded-[8px] border border-ink/12 bg-white/80 p-5 transition-colors hover:border-teal-mid/40 hover:bg-white"
							>
								<span class="font-mono text-xs uppercase tracking-wider text-muted">
									&larr; Previous Project
								</span>
								<span class="text-base font-medium text-ink group-hover:text-teal-mid">
									{prevCase.data.title}
								</span>
							</a>
						)}
					</div>
					<div class="sm:text-right">
						{nextCase && (
							<a
								href={`/cases/${nextCase.id}/`}
								class="group flex flex-col gap-1 rounded-[8px] border border-ink/12 bg-white/80 p-5 transition-colors hover:border-teal-mid/40 hover:bg-white"
							>
								<span class="font-mono text-xs uppercase tracking-wider text-muted">
									Next Project &rarr;
								</span>
								<span class="text-base font-medium text-ink group-hover:text-teal-mid">
									{nextCase.data.title}
								</span>
							</a>
						)}
					</div>
				</nav>
			)}
		</div>
	</article>
	<ImageLightbox />

	<script>
		const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
		if (tocLinks.length > 0) {
			const targets = tocLinks
				.map((link) => {
					const id = link.dataset.tocLink;
					const el = id ? document.getElementById(id) : null;
					return el ? { id, el, link } : null;
				})
				.filter((item): item is { id: string; el: HTMLElement; link: HTMLAnchorElement } =>
					Boolean(item),
				);

			const setActiveToc = (activeId: string) => {
				for (const { id, link } of targets) {
					const active = id === activeId;
					link.classList.toggle('border-teal-mid', active);
					link.classList.toggle('font-medium', active);
					link.classList.toggle('text-ink', active);
					link.classList.toggle('border-transparent', !active);
					link.classList.toggle('text-muted', !active);
				}
			};

			const syncToc = () => {
				const offset = 160;
				let currentId = targets[0]?.id || '';
				for (const { id, el } of targets) {
					if (el.getBoundingClientRect().top <= offset) {
						currentId = id;
					} else {
						break;
					}
				}
				if (currentId) setActiveToc(currentId);
			};

			for (const { id, link } of targets) {
				link.addEventListener('click', () => setActiveToc(id));
			}

			let ticking = false;
			const onScroll = () => {
				if (!ticking) {
					ticking = true;
					requestAnimationFrame(() => {
						ticking = false;
						syncToc();
					});
				}
			};

			syncToc();
			window.addEventListener('scroll', onScroll, { passive: true });
		}
	</script>
</Base>
