---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';

const cases = (await getCollection('cases')).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<Base
	title={`Case Studies — ${site.name}`}
	description="Selected product design, systems thinking, and UX research case studies by Marcel Akiyama."
	bodyClass="bg-dot-grid"
>
	<section class="py-14 md:py-20">
		<div class="container-page flex flex-col gap-[39px]">
			<div class="border-b border-ink/25 py-[17px]">
				<h1 class="section-eyebrow text-ink">ALL CASE STUDIES</h1>
			</div>

			<div class="grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
				{
					cases.map((entry) => (
						<a href={`/cases/${entry.id}/`} class="framer-case-card reveal group">
							<div class="framer-case-thumb">
								<img
									src={entry.data.coverImage}
									alt={entry.data.coverAlt || entry.data.title}
									loading="lazy"
								/>
							</div>
							<div class="flex flex-col gap-1.5">
								<h2 class="text-2xl font-medium leading-snug text-ink transition-colors group-hover:text-teal-mid">
									{entry.data.title}
								</h2>
								<p class="font-serif text-base leading-[1.6] text-ink">
									{entry.data.subtitle}
								</p>
							</div>
						</a>
					))
				}
			</div>
		</div>
	</section>
</Base>
