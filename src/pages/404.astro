---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
---

<Base title={`Page Not Found — ${site.name}`}>
	<section class="py-24 md:py-32">
		<div class="container-page max-w-2xl">
			<p class="section-eyebrow text-teal-dark">404 / Page not found</p>
			<h1 class="mt-4 text-3xl font-light leading-[1.12] tracking-tight text-forest-deep md:text-5xl">
				This page doesn&rsquo;t exist.
			</h1>
			<p class="mt-4 text-lg text-muted">
				The link you followed may have moved or been removed.
			</p>
			<a
				href="/"
				class="mt-8 inline-flex items-center gap-2 rounded-full bg-teal-dark px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-forest-deep"
			>
				&larr; Back to Home
			</a>
		</div>
	</section>
</Base>
