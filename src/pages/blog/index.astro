---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const formatDate = (date: Date) =>
	new Intl.DateTimeFormat('en-GB', {
		day: 'numeric',
		month: 'short',
		year: 'numeric',
	})
		.format(date)
		.replace(/ /g, ' ');
---

<Base title="Writing — m5rc238" description="Notes on type, motion, and building for the web.">
	<Header slot="header" />
	<Footer slot="footer" />

	<div class="container-page py-24">
		<h1
			data-hero
			class="font-display font-semibold text-balance text-display"
		>
			Writing
		</h1>
		<p class="mt-6 max-w-[52ch] text-muted text-lede">
			Notes on type, motion, and building for the web.
		</p>

		<div class="rule-gradient my-16" aria-hidden="true"></div>

		{
			posts.length === 0 ? (
				<p class="text-muted">Nothing published yet.</p>
			) : (
				<ul class="space-y-px overflow-hidden rounded-card border border-line bg-line">
					{posts.map((post) => (
						<li class="bg-surface">
							<a
								href={`/blog/${post.id}/`}
								class="card block p-8 sm:p-10"
							>
								<div class="flex flex-wrap items-baseline justify-between gap-3">
									<h2 class="reveal font-display text-xl font-semibold tracking-tight" data-reveal="split-lines">
										{post.data.title}
									</h2>
									<time
										datetime={post.data.pubDate.toISOString()}
										class="font-mono text-xs text-ink-500"
									>
										{formatDate(post.data.pubDate)}
									</time>
								</div>

								{post.data.description && (
									<p class="reveal mt-3 max-w-[60ch] text-sm leading-relaxed text-muted" data-reveal="fade-up">
										{post.data.description}
									</p>
								)}

								{post.data.tags.length > 0 && (
									<ul class="mt-5 flex flex-wrap gap-2">
										{post.data.tags.map((tag) => (
											<li class="rounded-pill border border-line px-3 py-1 font-mono text-xs text-ink-500">
												{tag}
											</li>
										))}
									</ul>
								)}
							</a>
						</li>
					))}
				</ul>
			)
		}
	</div>
</Base>
