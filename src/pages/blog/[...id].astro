---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	return posts.map((post) => ({
		params: { id: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
	new Intl.DateTimeFormat('en-GB', {
		day: 'numeric',
		month: 'long',
		year: 'numeric',
	})
		.format(date)
		.replace(/ /g, ' ');
---

<Base
	title={`${post.data.title} — m5rc238`}
	description={post.data.description ?? post.data.title}
	heroReveal={post.data.reveal}
>
	<Header slot="header" />
	<Footer slot="footer" />

	<article class="container-page py-24">
		<header class="max-w-[68ch]">
			<a
				href="/blog/"
				class="link-wipe font-mono text-xs tracking-[0.2em] text-accent-400 uppercase"
			>
				← Writing
			</a>

			<h1
				data-hero
				class="mt-8 font-display font-semibold text-balance text-display"
			>
				{post.data.title}
			</h1>

			<div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-xs text-ink-500">
				<time datetime={post.data.pubDate.toISOString()}>
					{formatDate(post.data.pubDate)}
				</time>
				{
					post.data.updatedDate && (
						<span>
							Updated {formatDate(post.data.updatedDate)}
						</span>
					)
				}
			</div>

			{
				post.data.tags.length > 0 && (
					<ul class="mt-6 flex flex-wrap gap-2">
						{post.data.tags.map((tag) => (
							<li class="rounded-pill border border-line px-3 py-1 font-mono text-xs text-ink-500">
								{tag}
							</li>
						))}
					</ul>
				)
			}
		</header>

		{
			post.data.heroImage && (
				<figure class="mt-16">
					<img
						src={post.data.heroImage}
						alt={post.data.heroAlt ?? ''}
						class="w-full rounded-card border border-line"
						loading="eager"
						decoding="async"
					/>
				</figure>
			)
		}

		<div class="rule-gradient my-16" aria-hidden="true"></div>

		{/*
			Prose lives outside Tailwind's utilities, so it is styled here. The
			class is referenced from the layout via the `.prose` component layer.
		*/}
		<div class="max-w-[68ch] leading-relaxed [&>p]:mt-6 [&>p:first-child]:mt-0 [&>h2]:mt-14 [&>h2]:mb-5 [&>h2]:font-display [&>h2]:text-2xl [&>h2]:font-semibold [&>h3]:mt-10 [&>h3]:mb-4 [&>h3]:font-display [&>h3]:text-xl [&>h3]:font-semibold [&>a]:text-accent-400 [&>a]:underline [&>a]:underline-offset-4 [&>ul]:mt-6 [&>ul]:list-disc [&>ul]:pl-6 [&>ol]:mt-6 [&>ol]:list-decimal [&>ol]:pl-6 [&>li]:mt-2 [&>blockquote]:my-8 [&>blockquote]:border-l-2 [&>blockquote]:border-accent-500 [&>blockquote]:pl-6 [&>blockquote]:text-muted [&>blockquote]:italic [&>code]:rounded [&>code]:bg-raised [&>code]:px-1.5 [&>code]:py-0.5 [&>code]:font-mono [&>code]:text-sm [&>pre]:my-8 [&>pre]:overflow-x-auto [&>pre]:rounded-card [&>pre]:border [&>pre]:border-line [&>pre]:bg-raised [&>pre]:p-6 [&>pre]:font-mono [&>pre]:text-sm [&>hr]:my-12 [&>hr]:border-line">
			<Content />
		</div>
	</article>
</Base>
