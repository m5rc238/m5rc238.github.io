---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const projects = (
	await getCollection('work', ({ data }) => !data.draft)
)
	.sort((a, b) => b.data.order - a.data.order)
	.sort((a, b) => Number(b.data.featured) - Number(a.data.featured));

const formatDate = (date: Date) =>
	`${date.getFullYear()}`;
---

<Base title="Work — m5rc238" description="Selected projects.">
	<Header slot="header" />
	<Footer slot="footer" />

	<div class="container-page py-24">
		<h1 data-hero class="font-display font-semibold text-balance text-display">
			Work
		</h1>
		<p class="mt-6 max-w-[52ch] text-muted text-lede">
			Selected projects, newest emphasis first.
		</p>

		<div class="rule-gradient my-16" aria-hidden="true"></div>

		<ul class="grid gap-6 sm:grid-cols-2">
			{
				projects.map((project) => (
					<li class="card p-8">
						<div class="flex items-baseline justify-between gap-3 font-mono text-xs text-ink-500">
							<time datetime={project.data.date.toISOString()}>
								{formatDate(project.data.date)}
							</time>
							{project.data.featured && (
								<span class="text-accent-400">Featured</span>
							)}
						</div>

						<h2
							class="reveal mt-4 font-display text-xl font-semibold tracking-tight"
							data-reveal="split-lines"
						>
							{project.data.title}
						</h2>

						{project.data.description && (
							<p class="reveal mt-3 text-sm leading-relaxed text-muted" data-reveal="fade-up">
								{project.data.description}
							</p>
						)}

						{(project.data.link || project.data.repo) && (
							<div class="mt-6 flex gap-4 text-sm">
								{project.data.link && (
									<a href={project.data.link} class="link-wipe text-accent-400">
										Visit
									</a>
								)}
								{project.data.repo && (
									<a href={project.data.repo} class="link-wipe text-muted">
										Source
									</a>
								)}
							</div>
						)}
					</li>
				))
			}
		</ul>
	</div>
</Base>
